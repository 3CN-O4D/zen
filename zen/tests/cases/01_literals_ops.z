# Literals, operators, built-in types
var fails = 0
func check(cond, name) {
    if cond { } else {
        print("FAIL: " + name)
        fails = fails + 1
    }
}

check(1 + 2 * 3 == 7, "precedence")
check(10 / 4 == 2.5, "float division")
check(10 % 3 == 1, "modulo")
check(-5 + 5 == 0, "negatives")
check(2 + "x" == "2x", "num-str concat")
check("a" + 1 == "a1", "str-num concat")

var s = "hello"
check(s.length() == 5, "string length")
check(s[0] == "h", "string index")
check(s.upper() == "HELLO", "upper")
check(s + " world" == "hello world", "concat")

var l = [1, 2, 3]
check(l.length() == 3, "list length")
check(l[1] == 2, "list index")
l.push(4)
check(l.length() == 4 && l[3] == 4, "list push")
l.pop()
check(l.length() == 3, "list pop")

var d = {a: 1, b: 2}
check(d["a"] == 1, "dict index")
check(d.b == 2, "dict dot access")
d["c"] = 3
check(d.c == 3, "dict insert")

check(1 < 2 && 2 <= 2, "comparisons and")
check(1 > 2 || 2 > 1, "comparisons or")
check(!(1 > 2), "not")

if fails == 0 { print("SUITE PASS") } else { print("SUITE FAILURES: " + str(fails)) }
