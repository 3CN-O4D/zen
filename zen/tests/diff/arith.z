# Differential probe: arithmetic, precedence and comparisons.
print(1 + 2 * 3)
print((1 + 2) * 3)
print(10 - 4 - 3)
print(2 + 3 * 4 - 6 / 2)
print(10 % 3)
print(7 / 2)
print(2 + "x")
print("a" + 1)
print("x" * 3)
print(1 < 2)
print(2 <= 2)
print(3 > 4)
print(1 < 2 && 2 <= 2)
print(1 > 2 || 2 > 1)
print(!(1 > 2))
print(!(1 < 2 && 2 > 2))
