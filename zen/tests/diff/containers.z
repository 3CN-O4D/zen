# Differential probe: lists, dicts, sets, tuples, indexing and mutation.
var l = [1, 2, 3]
l.push(4)
print(l)
print(l.length())
print(l[1])
l.pop()
print(l)

var d = {a: 1, b: 2}
d["c"] = 3
d.d = 4
print(d["a"] + d.b + d.c + d.d)
print(d.keys())

var s = %{1, 2, 2, 3}
print(s.length())

var t = #(1, "two")
print(t[0])
print(t[1])

print([1, 2] == [1, 2])
print({a: 1} == {a: 1})
