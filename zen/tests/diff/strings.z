# Differential probe: string methods.
var s = "Hello, World"
print(s.upper())
print(s.lower())
print(s.length())
print(s.contains("World"))
print(!s.contains("Nope"))
print(s.startswith("Hell"))
print(s.endswith("rld"))
print(s.replace("o", "0"))
print(s.find("World"))
print(s.find("zzz"))
print("a,b,c".split(",").length())
print("a,b,c".split(",")[1])
print("  pad  ".strip())
print("7".to_num() + 1)
print("ab"[1])
print(s.substring(7, 12))
print("x" * 3)
