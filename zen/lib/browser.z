login = function(url_input, username_input, password_input, submit_btn, username, password) {
  go(url_input)
  fill(username_input, username)
  fill(password_input, password)
  click(submit_btn)
}

table_to_list = function(table_selector) {
  rows = css(table_selector + " tr").skip(1)
  rows.map(function(row) {
    row.find_all("td").map(function(cell) { cell.text })
  })
}

screenshot_page = function(path) {
  pageHtml()
  shot(path)
}

type_text = function(selector, text, delay_ms) {
  for ch in text.toList() {
    fill(selector, ch)
  }
}

scroll_bottom = function() {
  execute("window.scrollTo(0, document.body.scrollHeight)")
}

scroll_top = function() {
  execute("window.scrollTo(0, 0)")
}

page_title = function() {
  execute("document.title")
}
