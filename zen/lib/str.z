lines = function(s) {
  s.split("\n")
}

slugify = function(s) {
  s = s.trim().toLower()
  result = ""
  for ch in s.toList() {
    if (ch >= "a" and ch <= "z") or (ch >= "0" and ch <= "9") or ch == "-" or ch == " " {
      if ch == " " {
        result = result + "-"
      } else {
        result = result + ch
      }
    }
  }
  prev = ""
  while result != prev {
    prev = result
    result = result.replaceAll("--", "-")
  }
  result
}

truncate = function(s, n) {
  if s.len <= n {
    s
  } else {
    s.slice(0, n) + "..."
  }
}

strip_tags = function(s) {
  result = ""
  in_tag = false
  for ch in s.toList() {
    if ch == "<" {
      in_tag = true
    } else if ch == ">" {
      in_tag = false
    } else if not in_tag {
      result = result + ch
    }
  }
  result
}

escape_html = function(s) {
  s = s.replaceAll("&", "&amp;")
  s = s.replaceAll("<", "&lt;")
  s = s.replaceAll(">", "&gt;")
  s = s.replaceAll("\"", "&quot;")
  s
}

to_csv = function(list) {
  list.map(function(row) {
    row.map(function(v) {
      s = str(v)
      if s.includes(",") or s.includes("\"") or s.includes("\n") {
        "\"" + s.replaceAll("\"", "\"\"") + "\""
      } else {
        s
      }
    }).join(",")
  }).join("\n")
}
