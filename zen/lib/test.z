__describe_stack = []
__failures = 0
__passed = 0

describe = function(name, fn) {
  __describe_stack.push(name)
  fn()
  __describe_stack.pop()
}

it = function(name, fn) {
  path = __describe_stack.join(" > ") + " > " + name
  try {
    fn()
    print("\033[32m✓\033[0m " + path)
    __passed = __passed + 1
  } catch err {
    print("\033[31m✗\033[0m " + path)
    print("  " + str(err))
    __failures = __failures + 1
  }
}

assert = function(cond) {
  if not cond { throw "Assertion failed" }
}

assertEq = function(a, b) {
  if a != b {
    throw "Expected " + str(a) + " to equal " + str(b)
  }
}

assertNotEq = function(a, b) {
  if a == b {
    throw "Expected " + str(a) + " to not equal " + str(b)
  }
}

summary = function() {
  print("")
  print("━━━━━━━━━━━━━━━━━━━━")
  total = __passed + __failures
  if __failures == 0 {
    print("\033[32mAll " + str(total) + " tests passed!\033[0m")
  } else {
    print("\033[31m" + str(__failures) + "/" + str(total) + " tests failed\033[0m")
  }
}
