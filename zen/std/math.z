// Pure-Zen reimplementation of the `math` module.
//
// Declares ZEN_PURE so the .z tier wins over the Rust tier on import; the
// native members stay reachable as `math.native.*` and setting
// ZEN_NATIVE_ONLY=math restores the native tier.
//
// Divergences from the native tier:
//   - No variadic calls: `min`/`max`/`fsum`/`prod`/`hypot` accept up to two
//     arguments (each may be a number or a list of numbers). Calls like
//     `math.min(1, 2, 3)` are unsupported in the pure tier.
ZEN_PURE = true

let _PI = 3.14159265358979323846
let _E = 2.71828182845904523536
let _TAU = 6.28318530717958647692
let _PI2 = _PI / 2
let _LN2 = 0.69314718055994530941
let _LN10 = 2.30258509299404568401
let _MAX = 1.7976931348623157e308

let inf = 1e400
let nan = 0.0 * inf

let pi = _PI
let e = _E

let abs = fn(x) {
    if x < 0 { return -x }
    return x
}

let _isnan = fn(x) {
    return x != x
}

let _isinf = fn(x) {
    let m = abs(x)
    return m > _MAX
}

let sqrt = fn(x) {
    return x ** 0.5
}

let pow = fn(a, b) {
    return a ** b
}

let _floor = fn(x) {
    if _isnan(x) { return x }
    if _isinf(x) { return x }
    let t = int(x)
    if t > x { return t - 1 }
    return t
}

let floor = fn(x) {
    return _floor(x)
}

let ceil = fn(x) {
    if _isnan(x) { return x }
    if _isinf(x) { return x }
    let t = int(x)
    if t < x { return t + 1 }
    return t
}

let trunc = fn(x) {
    if _isnan(x) { return x }
    return int(x)
}

let round = fn(x) {
    if _isnan(x) { return x }
    if _isinf(x) { return x }
    if x >= 0 { return int(x + 0.5) }
    return int(x - 0.5)
}

let exp = fn(x) {
    return _E ** x
}

let _ln2 = fn(x) {
    if _isnan(x) { return nan }
    if x == 0 { return -inf }
    if x < 0 { return nan }
    if x > _MAX { return inf }
    if x == 1 { return 0 }
    let k = 0
    let m = x
    if m >= 2 {
        while m >= 2 {
            m = m / 2
            k += 1
        }
    } elif m < 1 {
        while m < 1 {
            m = m * 2
            k -= 1
        }
    }
    let y = (m - 1) / (m + 1)
    let y2 = y * y
    let term = y
    let s = 0
    let n = 0
    while true {
        s += term / (2 * n + 1)
        term = term * y2
        n += 1
        if abs(term) < 1e-18 { break }
    }
    return 2 * s + k * _LN2
}

let log = fn(x, base = null) {
    if base == null { base = _E }
    let num = _ln2(x)
    if type(num) == "int" || type(num) == "float" { return num / _ln2(base) }
    return num
}

let log2 = fn(x) {
    let num = _ln2(x)
    if type(num) == "int" || type(num) == "float" { return num / _LN2 }
    return num
}

let log10 = fn(x) {
    let num = _ln2(x)
    if type(num) == "int" || type(num) == "float" { return num / _LN10 }
    return num
}

let _sin = fn(x) {
    let x2 = x * x
    let term = x
    let s = x
    let n = 1
    while true {
        term = -term * x2 / ((2 * n) * (2 * n + 1))
        s += term
        n += 1
        if abs(term) < 1e-18 { break }
    }
    return s
}

let _red = fn(x) {
    return x - _floor(x / _TAU) * _TAU
}

let _sinp = fn(q) {
    if q > _PI2 { return _sin(_PI - q) }
    return _sin(q)
}

let sin = fn(x) {
    let q = _red(x)
    if q >= _PI { return -_sinp(q - _PI) }
    return _sinp(q)
}

let cos = fn(x) {
    return sin(_PI2 - x)
}

let tan = fn(x) {
    return sin(x) / cos(x)
}

let _ats = fn(x) {
    let x2 = x * x
    let term = x
    let s = 0
    let n = 0
    while true {
        s += term / (2 * n + 1)
        term = -term * x2
        n += 1
        if abs(term) < 1e-18 { break }
    }
    return s
}

let atan = fn(x) {
    if x > 1 { return _PI2 - _ats(1 / x) }
    if x < -1 { return -_PI2 - _ats(1 / x) }
    if abs(x) < 0.5 { return _ats(x) }
    return 2 * _ats(x / (1 + sqrt(1 + x * x)))
}

let asin = fn(x) {
    if x > 1 { return nan }
    if x < -1 { return nan }
    if x == 1 { return _PI2 }
    if x == -1 { return -_PI2 }
    return atan(x / sqrt(1 - x * x))
}

let acos = fn(x) {
    return _PI2 - asin(x)
}

let atan2 = fn(y, x) {
    if x == 0 {
        if y > 0 { return _PI2 }
        if y < 0 { return -_PI2 }
        return 0
    }
    let r = atan(y / x)
    if x > 0 { return r }
    if y >= 0 { return r + _PI }
    return r - _PI
}

let degrees = fn(x) {
    return x * 180 / _PI
}

let radians = fn(x) {
    return x * _PI / 180
}

let _gcd = fn(a, b) {
    a = int(a)
    b = int(b)
    if a < 0 { a = -a }
    if b < 0 { b = -b }
    while b != 0 {
        let t = b
        b = a % b
        a = t
    }
    return a
}

let gcd = fn(a, b) {
    return _gcd(a, b)
}

let lcm = fn(a, b) {
    a = int(a)
    b = int(b)
    if a == 0 || b == 0 { return 0 }
    if a < 0 { a = -a }
    if b < 0 { b = -b }
    return a / _gcd(a, b) * b
}

let factorial = fn(n) {
    n = int(n)
    let res = 1
    let i = 2
    while i <= n {
        res = res * i
        i += 1
    }
    return res
}

let comb = fn(n, k) {
    n = int(n)
    k = int(k)
    if k < 0 || k > n { return 0 }
    if k > n - k { k = n - k }
    let res = 1
    let i = 0
    while i < k {
        res = res * (n - i) / (i + 1)
        i += 1
    }
    return res
}

let perm = fn(n, k = null) {
    n = int(n)
    if k == null { k = n }
    k = int(k)
    if k < 0 || k > n { return 0 }
    let res = 1
    let i = 0
    while i < k {
        res = res * (n - i)
        i += 1
    }
    return res
}

let remainder = fn(x, y) {
    return x - round(x / y) * y
}

let copysign = fn(x, y) {
    let m = abs(x)
    if y < 0 { return -m }
    return m
}

let _flat = fn(a, b) {
    let nums = []
    for x in [a, b] {
        if type(x) == "list" {
            for y in x {
                if type(y) == "int" || type(y) == "float" { nums.push(y) }
            }
        } elif type(x) == "int" || type(x) == "float" {
            nums.push(x)
        }
    }
    return nums
}

let min = fn(a, b = null) {
    let nums = _flat(a, b)
    if len(nums) == 0 { throw "min expects at least one number" }
    let m = nums[0]
    for x in nums {
        if x < m { m = x }
    }
    return m
}

let max = fn(a, b = null) {
    let nums = _flat(a, b)
    if len(nums) == 0 { throw "max expects at least one number" }
    let m = nums[0]
    for x in nums {
        if x > m { m = x }
    }
    return m
}

let fsum = fn(a, b = null) {
    let nums = _flat(a, b)
    let s = 0
    for x in nums {
        s += x
    }
    return s
}

let prod = fn(a, b = null) {
    let nums = _flat(a, b)
    let s = 1
    for x in nums {
        s *= x
    }
    return s
}

let hypot = fn(a, b = null) {
    let nums = _flat(a, b)
    let s = 0
    for x in nums {
        s += x * x
    }
    return sqrt(s)
}

let isnan = fn(x) {
    return _isnan(x)
}

let isfinite = fn(x) {
    return !_isnan(x) && !_isinf(x)
}

let isinf = fn(x) {
    return _isinf(x)
}

let modf = fn(x) {
    let t = trunc(x)
    return [x - t, t]
}

let frexp = fn(x) {
    if x == 0 { return [0, 0] }
    let m = abs(x)
    let exponent = _floor(_ln2(m) / _LN2) + 1
    return [x / (2 ** exponent), exponent]
}

let ldexp = fn(x, exponent) {
    return x * (2 ** exponent)
}