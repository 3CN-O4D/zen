pub class KeyPair {
    let private_key: String
    let public_key: String

    pub init(private_key: String, public_key: String) {
        self.private_key = private_key
        self.public_key = public_key
    }
}

pub fn generate_rsa(bits: Int = 2048) -> KeyPair {
    let keys = __native_crypto_rsa_generate(bits)
    return KeyPair(keys[0], keys[1])
}

pub fn rsa_encrypt(public_key: String, plaintext: String) -> String {
    return __native_crypto_rsa_encrypt(public_key, plaintext)
}

pub fn rsa_decrypt(private_key: String, ciphertext: String) -> String {
    return __native_crypto_rsa_decrypt(private_key, ciphertext)
}

pub fn rsa_sign(private_key: String, message: String) -> String {
    return __native_crypto_rsa_sign(private_key, message)
}

pub fn rsa_verify(public_key: String, message: String, sig: String) -> Bool {
    return __native_crypto_rsa_verify(public_key, message, sig)
}

pub fn generate_ed25519() -> KeyPair {
    let keys = __native_crypto_ed25519_generate()
    return KeyPair(keys[0], keys[1])
}

pub fn ed25519_sign(private_key: String, message: String) -> String {
    return __native_crypto_ed25519_sign(private_key, message)
}

pub fn ed25519_verify(public_key: String, message: String, sig: String) -> Bool {
    return __native_crypto_ed25519_verify(public_key, message, sig)
}

pub fn generate_x25519() -> KeyPair {
    let keys = __native_crypto_x25519_generate()
    return KeyPair(keys[0], keys[1])
}

pub fn x25519_shared_secret(private_key: String, public_key: String) -> String {
    return __native_crypto_x25519_shared(private_key, public_key)
}
