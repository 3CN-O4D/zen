let url = "https://cube-community-api.vercel.app/api/v1/peoples-choice/vote"
let applicantId = "seed-018"
let track = "Medical & HealthTech"
let delay_ms = 200

let reqHeaders = {
    "Host": "cube-community-api.vercel.app",
    "Sec-Ch-Ua-Platform": "\"Linux\"",
    "Accept-Language": "en-US,en;q=0.9",
    "Accept": "application/json, text/plain, */*",
    "Sec-Ch-Ua": "\"Not-A.Brand\";v=\"24\", \"Chromium\";v=\"146\"",
    "Content-Type": "application/json",
    "Sec-Ch-Ua-Mobile": "?0",
    "User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/146.0.0.0 Safari/537.36",
    "Origin": "https://the-cube.co.ke",
    "Sec-Fetch-Site": "cross-site",
    "Sec-Fetch-Mode": "cors",
    "Sec-Fetch-Dest": "empty",
    "Referer": "https://the-cube.co.ke/",
    "Accept-Encoding": "gzip, deflate, br",
    "Priority": "u=1, i"
}

function randomFingerprint() {
    return random.hex(64)
}

print "\033[1;36m╔══════════════════════════════════════════════╗"
print "║     \033[1;33mZen Vote Bot  —  Peoples Choice\033[1;36m        ║"
print "╠══════════════════════════════════════════════╣"
print "║  Applicant: \033[1;33m" + applicantId + "\033[1;36m"
print "║  Track:     \033[1;33m" + track + "\033[1;36m"
print "║  Mode:      \033[1;33mUnlimited (Ctrl+C to stop)\033[1;36m"
print "╚══════════════════════════════════════════════╝"
print ""

let success = 0
let failed = 0
let count = 0

while true {
    count = count + 1
    let fp = randomFingerprint()
    let body = {
        "applicantId": applicantId,
        "track": track,
        "fingerprint": fp
    }

    let resp = http.post(url, json=body, headers=reqHeaders)

    if resp.ok {
        let data = resp.json()
        let msg = data["message"]
        if msg == null {
            msg = resp.body
        }
        success = success + 1
        print "\033[1;36m[" + count + "]\033[0m \033[1;32m✓\033[0m " + msg
    } else {
        failed = failed + 1
        print "\033[1;36m[" + count + "]\033[0m \033[1;31m✗\033[0m HTTP " + resp.status + " — " + resp.body
    }

    wait(delay_ms)
}
