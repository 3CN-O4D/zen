// wa_auth.z — WhatsApp authentication via QR code or pairing code.
// Usage: zen run examples/wa_auth.z
// The session persists in ~/.zen/wa_session — run again to reuse it.

import wa

print("WhatsApp auth")
print("  1. QR Code (scan from phone)")
print("  2. Pairing Code (enter phone number)")
var choice = input("Method [1/2]: ")

if choice == "2" {
    var phone = input("Phone number with country code (e.g. 254712345678): ")
    print("Requesting pairing code...")
    wa.connect("", phone)
    # pairing code arrives shortly after the bridge reaches the server
    var code = null
    for i in range(0, 40) {
        code = wa.pairingCode()
        if code != null { break }
        wait(500)
    }
    if code == null {
        print("ERROR: no pairing code received. state =", wa.state())
        wa.disconnect()
        return
    }
    print("")
    print("=========================================")
    print "Pairing code: " + code
    print("Open WhatsApp -> Settings -> Linked Devices")
    print("-> Link a Device -> Link with phone number")
    print("=========================================")
} else {
    print("A QR code is rendering below/above. Scan it with:")
    print("WhatsApp -> Settings -> Linked Devices -> Link a Device")
    wa.connect()
}

# Wait up to 90s for the connection to complete.
var state = ""
for i in range(0, 180) {
    state = wa.state()
    if state == "connected" || state == "dead" { break }
    wait(500)
}

if state == "connected" {
    print("")
    print("=== WhatsApp connected ===")
    print("Session saved. Future runs skip the QR/pairing step.")
    print("Try: zen run examples/wa_bot.z")
} else {
    print("")
    print("Connection did not complete. Final state:", state)
}
