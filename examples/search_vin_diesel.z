go "https://www.google.com/search?q=vin+diesel"
wait 3000

href_js = 'return [...document.querySelectorAll("a[href^=\\"http\\"]")].filter(a => !a.href.includes("google.com") && a.textContent.trim()).map(a => a.href)'
links = execute(href_js)

txt_js = 'return [...document.querySelectorAll("a[href^=\\"http\\"]")].filter(a => !a.href.includes("google.com") && a.textContent.trim()).map(a => a.textContent.trim())'
titles = execute(txt_js)

print "Found " + str(len(links)) + " results."
if len(links) > 5 {
  print "Opening (" + str(6) + "/" + str(len(links)) + "): " + titles[5]
  go links[5]
  wait 5000
  body = page_text()
  if body != null {
    for line in body.split("\n") {
      line = line.trim()
      if line != "" {
        print line
        wait 300
      }
    }
  } else {
    print "(no text content)"
  }
} else {
  for i in range(len(links)) {
    print str(i+1) + ". " + titles[i]
  }
}
print "Done."
