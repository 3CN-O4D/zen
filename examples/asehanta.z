// asehanta.z — Scrape house listings from asehanta.com via Supabase API

let url = "https://ewfyrnxwmqdhlzpcfxxg.supabase.co/rest/v1/listings"
let key = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImV3Znlybnh3bXFkaGx6cGNmeHhnIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODM5OTA4MTIsImV4cCI6MjA5OTU2NjgxMn0._ZcmeZOe12t5DkuOkGU3qbk1641o_2Bk0AsIZ5NN0Vs"

let resp = http.get(url + "?status=eq.published&select=title,location,rent,price,house_type,descriptive_location,issues_count,vacancy_type,description,images,youtube_url,youtube_urls,video_urls", headers={"apikey": key, "Authorization": "Bearer " + key})

if not resp.ok {
    print "Error: HTTP " + resp.status
    exit 1
}

let houses = resp.json()

print ""
print "=========================================="
print "   AseHanta — Available Houses"
print "=========================================="
print ""

let i = 0
for house in houses {
    i = i + 1
    print i + ". " + house.title
    print "   Location: " + house.descriptive_location + ", " + house.location
    print "   Type:     " + house.house_type
    print "   Rent:     KSh " + str(house.rent) + "/mo"
    print "   Charge:   KSh " + str(house.price)
    if house.issues_count > 0 {
        print "   Issues:   " + str(house.issues_count)
    }
    print "   Vacancy:  " + (house.vacancy_type if house.vacancy_type else "Inconclusive")
    print "   Images:"
    for img in (house.images if house.images else []) {
        print "     - " + img
    }
    print "   YouTube:"
    if house.youtube_url {
        print "     - " + house.youtube_url
    }
    for yt in (house.youtube_urls if house.youtube_urls else []) {
        print "     - " + yt
    }
    print "   Videos:"
    for v in (house.video_urls if house.video_urls else []) {
        print "     - " + v
    }
    print ""
}

print "=========================================="
print "   Total: " + str(len(houses)) + " houses"
print "=========================================="
