// Login form automation
// zen run examples/login.zen

go "https://the-internet.herokuapp.com/login"

// Fill login form using member access pattern
let username = find("#username")
let password = find("#password")

print "Found form fields:"
print "Username field exists: " + username.exists
print "Password field exists: " + password.exists

username.fill("tomsmith")
password.fill("SuperSecretPassword!")

// Submit via button click
click find(".radius")

// Verify login
wait for ".flash.success"
print "Page title: " + title()

let msg = text(".flash")
if "You logged into a secure area!" in msg {
    print "LOGIN SUCCESSFUL"
} else {
    print "LOGIN FAILED: " + msg
}

// Logout
click find(".button.secondary.radius")
wait for ".flash"
print "Logged out"

shot "/tmp/login_result.png"
print "Screenshot saved to /tmp/login_result.png"
