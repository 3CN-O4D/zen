go "https://www.google.com"
let query = "zen browser automation language"
fill "textarea[name='q']" with query
execute("document.querySelector('textarea[name=\"q\"]').closest('form').submit()")
wait for "h3"
let results = texts("h3")
print "=== Search Results ==="
for result in results {
    print "- " + result
}
print ""
print "Found " + len(results) + " results"
shot "google_results.png" full
