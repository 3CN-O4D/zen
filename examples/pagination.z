// Paginated crawl example
// Scrapes multiple pages with data extraction
// zen run examples/pagination.zen

go "https://books.toscrape.com/"

let all_titles = []
let page = 1

while page <= 3 {
    print "\n--- Page " + page + " ---"

    // Extract book info using find_all
    let books = find_all("article.product_pod h3 a")
    let prices = find_all("article.product_pod .price_color")

    print "Found " + books.count + " books"

    // Inspect results with .each()
    books.each(function(el, i) {
        let title = el.attr("title")
        all_titles.append(title)
        print "  " + (i + 1) + ". " + title
    })

    // Try next page
    let next = find(".next a")
    if next.exists {
        click next
        wait 1000
        page = page + 1
    } else {
        print "No more pages"
        break
    }
}

print "\n=== CRAWL COMPLETE ==="
print "Total titles: " + all_titles.len
print "All titles: " + all_titles

write_file("/tmp/scraped_titles.txt", all_titles.join("\n"))
print "Titles saved to /tmp/scraped_titles.txt"
