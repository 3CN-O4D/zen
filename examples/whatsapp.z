// WhatsApp Web automation example
// Note: QR code scan required for first login

go "https://web.whatsapp.com"
print "Scan QR code to login..."
wait for "canvas"  // wait for QR code (or main view if already logged in)

// Wait for chat list to load
wait 10000
wait for "div[role='row']"

// Get chat names
let chats = texts("div[role='row'] span[title]")
print "Recent chats:"
for chat in chats {
    print "- " + chat
}
