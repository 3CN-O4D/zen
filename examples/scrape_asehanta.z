// scrape_asehanta.z — Full scrape with data transformation + file save
// Tests: for-in, range(), try/catch, json.save/load, string methods

go "https://asehanta.com"
wait 6

let count = js("document.querySelectorAll('.group-item').length")
print "Found " + str(count) + " listings"

let all_data = []

for i in range(count) {
    print ""
    print "--- Listing " + str(i + 1) + " ---"

    let listing_title = js("var cards = document.querySelectorAll('.group-item'); var txts = cards[" + str(i) + "].querySelectorAll('.bubble-element.Text, .Text'); for(var j=0; j<txts.length; j++) { var t = txts[j].innerText.trim(); if(t && t.length > 5 && t.indexOf('More photos') < 0 && t.indexOf('ksh') < 0 && t.indexOf('Fees') < 0 && t.indexOf('View Details') < 0 && t.indexOf('Listed by') < 0 && t.indexOf('Available') < 0) return t } return ''")

    let rent_str = js("var cards = document.querySelectorAll('.group-item'); var txts = cards[" + str(i) + "].querySelectorAll('.bubble-element.Text'); for(var j=0; j<txts.length; j++) { var t = txts[j].innerText.trim().toLowerCase(); if(t.indexOf('ksh') >= 0) return txts[j].innerText.trim() } return ''")

    let fees_str = js("var cards = document.querySelectorAll('.group-item'); var txts = cards[" + str(i) + "].querySelectorAll('.bubble-element.Text'); for(var j=0; j<txts.length; j++) { var t = txts[j].innerText.trim(); if((t.indexOf('Fees') >= 0 || t.indexOf('KSH') >= 0) && t.indexOf('ksh') < 0) return t } return ''")

    let img_url = js("var cards = document.querySelectorAll('.group-item'); var imgs = cards[" + str(i) + "].querySelectorAll('img'); for(var j=0; j<imgs.length; j++) { var src = imgs[j].src; if(src.indexOf('w=1024') >= 0) return src } return ''")

    print "  Title: " + listing_title
    print "  Rent: " + rent_str
    print "  Fees: " + fees_str
    print "  Image: " + img_url

    // Click the image to open popup
    js("var cards = document.querySelectorAll('.group-item'); var clickables = cards[" + str(i) + "].querySelectorAll('.clickable-element'); for(var j=0; j<clickables.length; j++) { if(clickables[j].innerText.indexOf('More photos') >= 0 || clickables[j].className.indexOf('Image') >= 0) { clickables[j].click(); return 'ok' } } return 'no'")
    wait 4

    // Extract popup data with try/catch
    let popup_data = "{}"
    try {
        popup_data = js("var p = document.querySelector('.bubble-element.Popup'); if(!p || p.style.display == 'none') return '{}'; var iframes = p.querySelectorAll('iframe'); var imgs = p.querySelectorAll('img'); var tiktok_blocks = p.querySelectorAll('.tiktok-embed'); var result = {iframes: [], images: [], tiktok_urls: [], tiktok_embed: ''}; iframes.forEach(function(f) { result.iframes.push(f.src || f.getAttribute('src')) }); imgs.forEach(function(img) { result.images.push(img.src) }); tiktok_blocks.forEach(function(t) { result.tiktok_urls.push(t.getAttribute('cite') || ''); result.tiktok_embed = t.outerHTML.substring(0, 1000) }); return JSON.stringify(result)")
    } catch err {
        print "  Popup error: " + str(err)
    }

    print "  Popup: " + popup_data

    // Parse popup JSON to extract YouTube IDs
    let popup_parsed = json.parse(popup_data)
    let youtube_ids = []
    let extra_images = []
    if popup_parsed.has("iframes") {
        for f in popup_parsed.iframes {
            if f.contains("youtube") or f.contains("youtu.be") {
                // Extract video ID from URL
                let parts = f.split("/")
                let last = parts[len(parts) - 1]
                let vid = last.split("?")[0]
                youtube_ids.push(vid)
            }
        }
    }
    if popup_parsed.has("images") {
        extra_images = popup_parsed.images
    }

    print "  YouTube IDs: " + json.encode(youtube_ids)
    print "  Extra images: " + str(len(extra_images))

    // Store data
    let item = {}
    item.title = listing_title
    item.rent = rent_str
    item.fees = fees_str
    item.image = img_url
    item.youtube_ids = youtube_ids
    item.extra_images = extra_images
    item.popup_raw = popup_data
    all_data.push(item)

    // Close popup
    js("var closeBtn = document.querySelector('.bubble-element.Popup button, .bubble-element.Popup .Icon'); if(closeBtn) { closeBtn.click(); } else { var overlay = document.querySelector('.greyout'); if(overlay) overlay.click(); }")
    wait 2
}

print ""
print "=== " + str(len(all_data)) + " listings scraped ==="

// Save to file
let output_path = "/tmp/asehanta_listings.json"
json.save(output_path, all_data)
print "Saved to " + output_path

// Also print for verification
print ""
print json.encode(all_data, pretty=true)
