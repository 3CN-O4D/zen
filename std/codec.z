# codec.z — CTF/recon text transforms.
#
# rot13/rot47, repeating-key XOR, JWT decoding (structure only — signatures
# are never verified here), and stepwise `pipe` chains like
# `pipe(data, ["b64d", "rot13"])`. Pure offline, pure Zen.
#
# Only test systems you own or are authorized to audit.

import base64
import binascii

func rot13(s) {
    var out = ""
    for c in list(str(s)) {
        let o = c.ord()
        if o >= 97 and o <= 122 {
            out += chr(97 + (o - 97 + 13) % 26)
        } elif o >= 65 and o <= 90 {
            out += chr(65 + (o - 65 + 13) % 26)
        } else {
            out += c
        }
    }
    return out
}

func rot47(s) {
    var out = ""
    for c in list(str(s)) {
        let o = c.ord()
        if o >= 33 and o <= 126 {
            out += chr(33 + (o - 33 + 47) % 94)
        } else {
            out += c
        }
    }
    return out
}

func xor(data, key) {
    var kb = []
    if type(key) == "string" {
        for c in list(key) { kb.push(c.ord()) }
    } else {
        kb.push(int(key))
    }
    if len(kb) == 0 { throw "codec.xor: empty key" }
    var out = ""
    var i = 0
    for c in list(str(data)) {
        out += chr((c.ord() ^ kb[i % len(kb)]) % 256)
        i += 1
    }
    return out
}

func jwt_decode(token) {
    let parts = str(token).split(".")
    if len(parts) != 3 { throw "codec.jwt_decode: expected header.payload.signature" }
    let header_text = base64.url_decode(parts[0])
    let payload_text = base64.url_decode(parts[1])
    var header = null
    var payload = null
    try { header = json.parse(header_text) } catch { }
    try { payload = json.parse(payload_text) } catch { }
    return {header_text: header_text, payload_text: payload_text, signature: parts[2], header: header, payload: payload}
}

func pipe(data, steps) {
    var cur = data
    for st in steps {
        if st == "rot13" { cur = rot13(cur) }
        elif st == "rot47" { cur = rot47(cur) }
        elif st == "b64e" { cur = base64.encode(cur) }
        elif st == "b64d" { cur = base64.decode(cur) }
        elif st == "hex" { cur = binascii.hexlify(cur) }
        elif st == "unhex" { cur = binascii.unhexlify(cur) }
        else { throw "codec.pipe: unknown step: " + str(st) }
    }
    return cur
}
