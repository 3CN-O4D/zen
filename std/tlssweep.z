# tlssweep.z — multi-host TLS posture sweeps.
#
# Fetches and grades TLS certificates across many hosts, composing the M1/M2
# chain (`tls.fetch` -> `x509.parse_pem` -> `tlscheck.assess`) with the M3
# `report` builder. A sweep never aborts on one bad host: unreachable hosts
# and handshake failures become `info` findings instead of errors.
#
# Targets are `"host"` or `"host:port"` strings.
#
# Only test systems you own or are authorized to audit.

import report
import tls
import tlscheck
import x509

func _split_target(target) {
    let parts = str(target).split(":")
    if len(parts) == 2 {
        return {host: parts[0], port: int(parts[1])}
    }
    return {host: str(target), port: 443}
}

func sweep_host(target, opts = null) {
    let hp = _split_target(target)
    let insecure = false
    let timeout = 10000
    if opts != null {
        if opts.get("insecure", false) { insecure = true }
        timeout = opts.get("timeout_ms", 10000)
    }
    var pem = null
    try {
        pem = tls.fetch(hp["host"], hp["port"], {insecure: insecure, timeout_ms: timeout})
    } catch as e {
        return {target: str(target), ok: false, findings: [
            {severity: "info", title: "host unreachable or no TLS",
             detail: str(target) + ": " + e, evidence: "", remediation: ""}
        ]}
    }
    var cert = null
    try {
        cert = x509.parse_pem(pem)
    } catch as e {
        return {target: str(target), ok: false, findings: [
            {severity: "info", title: "unparseable certificate",
             detail: str(target) + ": " + e, evidence: "", remediation: ""}
        ]}
    }
    var findings = tlscheck.assess(cert, hp["host"])
    for f in findings {
        f["evidence"] = str(target)
    }
    return {target: str(target), ok: true, findings: findings}
}

func sweep(targets, opts = null) {
    var out = []
    for t in targets {
        out.push(sweep_host(t, opts))
    }
    return out
}

func sweep_report(title, targets, opts = null) {
    let r = report.create(title)
    for res in sweep(targets, opts) {
        r.extend(res["findings"])
    }
    return r
}
