// INI / config-file parsing in the spirit of Python's `configparser`.
//
// `parse(text)` (or `read(path)`) builds a `Config` with named sections,
// `DEFAULT` fallbacks, typed getters, mutation, and serialization back via
// `write()`. Keys are case-sensitive; `get` checks the section first, then
// `DEFAULT`, then the given default.

import fs

class Config {
    var sections
    var defaults

    func init() {
        sections = {}
        defaults = {}
    }

    func has_section(name) {
        return sections.has(name)
    }

    func has_option(section, option) {
        if sections.has(section) and sections.get(section).has(option) {
            return true
        }
        return defaults.has(option)
    }

    func set(section, option, value) {
        // NOTE: method results arrive by value, so nested mutation must go
        // through one chained assignment rooted at the field itself.
        if not sections.has(section) {
            sections[section] = {}
        }
        sections[section][option] = str(value)
        return null
    }

    func set_default(option, value) {
        defaults[option] = str(value)
        return null
    }

    func get(section, option, dflt) {
        if sections.has(section) {
            let s = sections.get(section)
            if s.has(option) { return s.get(option) }
        }
        if defaults.has(option) { return defaults.get(option) }
        return dflt
    }

    func getint(section, option, dflt) {
        let v = self.get(section, option, null)
        if v == null { return dflt }
        return int(str(v).strip())
    }

    func getfloat(section, option, dflt) {
        let v = self.get(section, option, null)
        if v == null { return dflt }
        return float(str(v).strip())
    }

    func getbool(section, option, dflt) {
        let v = self.get(section, option, null)
        if v == null { return dflt }
        let s = str(v).strip().lower()
        if s == "1" or s == "yes" or s == "true" or s == "on" { return true }
        if s == "0" or s == "no" or s == "false" or s == "off" { return false }
        return dflt
    }

    func options(section) {
        let out = []
        if sections.has(section) {
            for k in sections.get(section).keys() { out.push(k) }
        }
        return out
    }

    func section_names() {
        let out = []
        for k in sections.keys() { out.push(k) }
        return out
    }

    func write() {
        let lines = []
        if len(defaults.keys()) > 0 {
            lines.push("[DEFAULT]")
            for k in defaults.keys() {
                lines.push(k + " = " + defaults.get(k))
            }
            lines.push("")
        }
        for name in sections.keys() {
            lines.push("[" + name + "]")
            let s = sections.get(name)
            for k in s.keys() {
                lines.push(k + " = " + s.get(k))
            }
            lines.push("")
        }
        return _join_lines(lines)
    }
}

let _join_lines = fn(lines) {
    let out = ""
    let i = 0
    while i < len(lines) {
        if i > 0 { out = out + "\n" }
        out = out + lines[i]
        i += 1
    }
    return out
}

let _strip_comment = fn(line) {
    // A `#` or `;` starts a comment only at line start or after whitespace
    // (so `url = http://x/#y` survives).
    let i = 0
    while i < len(line) {
        let c = line[i]
        if c == "#" or c == ";" {
            if i == 0 or line[i - 1] == " " or line[i - 1] == "\t" {
                return line[:i].strip()
            }
        }
        i += 1
    }
    return line.strip()
}

let parse = fn(text) {
    let cfg = new Config()
    let cur = null
    let last_key = null
    for raw in text.split("\n") {
        let line = _strip_comment(raw)
        if len(line) == 0 { continue }
        if line[0] == "[" and line[len(line) - 1] == "]" {
            cur = line[1:len(line) - 1].strip()
            last_key = null
            if cur == "DEFAULT" {
                cur = null
            } else if not cfg.sections.has(cur) {
                cfg.sections[cur] = {}
            }
            continue
        }
        // continuation: indented line appends to the previous value
        if (raw[0] == " " or raw[0] == "\t") and last_key != null {
            if cur == null {
                cfg.defaults[last_key] = cfg.defaults.get(last_key) + "\n" + line
            } else {
                cfg.sections[cur][last_key] = cfg.sections.get(cur).get(last_key) + "\n" + line
            }
            continue
        }
        // key = value  |  key : value  |  bare key (= null)
        let sep = -1
        let k = 0
        while k < len(line) {
            if line[k] == "=" or line[k] == ":" {
                sep = k
                break
            }
            k += 1
        }
        let key = ""
        let val = null
        if sep == -1 {
            key = line.strip()
        } else {
            key = line[:sep].strip()
            val = line[sep + 1:].strip()
        }
        if len(key) == 0 { continue }
        last_key = key
        if cur == null {
            if val == null {
                cfg.defaults[key] = ""
            } else {
                cfg.defaults[key] = val
            }
        } else {
            if val == null {
                cfg.sections[cur][key] = ""
            } else {
                cfg.sections[cur][key] = val
            }
        }
    }
    return cfg
}

let read = fn(path) {
    return parse(fs.read(path))
}
