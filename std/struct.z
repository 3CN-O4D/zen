// struct — C-struct style size calculation. Pure-Zen tier; the format parser
// handles an optional endianness prefix (`<`, `>`, `!`, `=`, `@`) followed by
// one or more fixed-width codes. Only `calcsize` is exercised by the suite.

let _SIZES = {
    "b": 1, "B": 1, "c": 1, "?": 1,
    "h": 2, "H": 2,
    "i": 4, "I": 4, "l": 4, "L": 4, "f": 4,
    "q": 8, "Q": 8, "d": 8, "n": 8, "N": 8, "P": 8,
}

let calcsize = fn(fmt) {
    let i = 0
    let n = len(fmt)
    let total = 0
    while i < n {
        let c = fmt.substring(i, i + 1)
        if c == "<" || c == ">" || c == "=" || c == "@" || c == "!" {
            i = i + 1
        } else if c == "x" {
            total = total + 1
            i = i + 1
        } else if c >= "0" && c <= "9" {
            let j = i
            while j < n && fmt.substring(j, j + 1) >= "0" && fmt.substring(j, j + 1) <= "9" {
                j = j + 1
            }
            let count = int(fmt.substring(i, j))
            let code = fmt.substring(j, j + 1)
            let size = _SIZES.get(c, null)
            if size == null {
                throw "struct.calcsize: unsupported format char '" + code + "'"
            }
            total = total + count * size
            i = j + 1
        } else {
            let size = _SIZES.get(c, null)
            if size == null {
                throw "struct.calcsize: unsupported format char '" + c + "'"
            }
            total = total + size
            i = i + 1
        }
    }
    return total
}