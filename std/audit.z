# audit.z — authorized-audit module framework.
#
# Metasploit-shaped scaffolding for audit modules: named checks run against
# an explicit scope, results come back as report-ready findings, and anything
# outside the declared scope refuses to run. Checks never abort each other:
# a throwing check becomes an `info` finding.
#
# Checks are user functions `fn(target)` returning a finding dict or null.
# Findings plug directly into `report.create(...).extend(...)`.
#
# Only test systems you own or are authorized to audit. There is no
# exploitation support here by design — detection and reporting only.

func create(name, description = "") {
    # Lists are reference-typed, so every closure below shares the same
    # scope/check storage (the hashlib.z pattern).
    let scope = []
    let checks = []
    let m = {}
    m["name"] = name
    m["description"] = description
    m["set_scope"] = fn(targets) {
        while len(scope) > 0 { scope.pop() }
        for t in targets { scope.push(t) }
        return len(scope)
    }
    m["scope"] = fn() {
        var out = []
        for t in scope { out.push(t) }
        return out
    }
    m["add_check"] = fn(check_name, check_fn) {
        checks.push({name: check_name, run: check_fn})
        return len(checks)
    }
    m["in_scope"] = fn(target) {
        for t in scope {
            if t == target { return true }
        }
        return false
    }
    m["run_checks"] = fn(target) {
        var allowed = false
        for t in scope {
            if t == target { allowed = true }
        }
        if not allowed {
            throw "audit: target `" + str(target) + "` is outside the declared scope of `" + name + "`"
        }
        var out = []
        for c in checks {
            var finding = null
            try {
                finding = c["run"](target)
            } catch as e {
                finding = {severity: "info", title: "check `" + c["name"] + "` failed",
                    detail: str(e), evidence: str(target), remediation: ""}
            }
            if finding != null { out.push(finding) }
        }
        return out
    }
    return m
}
