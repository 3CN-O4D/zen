// Text wrapping and filling in the spirit of Python's `textwrap`.
//
// `wrap` returns a list of lines, `fill` joins them back; `dedent` strips
// common leading whitespace, `indent` adds a prefix, and `shorten` collapses
// text to a single line of at most `width` columns.

let _is_space = fn(c) {
    return c == " " or c == "\t" or c == "\n" or c == "\r"
}

let _split_words = fn(text) {
    // Splits into alternating runs of non-space / space runs, so the exact
    // spacing can be reconstructed or collapsed by the caller.
    let parts = []
    let i = 0
    let n = len(text)
    while i < n {
        let start = i
        if _is_space(text[i]) {
            while i < n and _is_space(text[i]) {
                i += 1
            }
        } else {
            while i < n and not _is_space(text[i]) {
                i += 1
            }
        }
        parts.push(text[start:i])
    }
    return parts
}

let _words = fn(text) {
    let out = []
    for p in _split_words(text) {
        if not _is_space(p[0]) { out.push(p) }
    }
    return out
}

let wrap = fn(text, width) {
    if width == null { width = 70 }
    let lines = []
    let cur = ""
    for w in _words(text) {
        if len(w) > width {
            // Break overlong words into width-sized chunks.
            if len(cur) > 0 {
                lines.push(cur)
                cur = ""
            }
            let k = 0
            while k < len(w) {
                lines.push(w[k:k + width])
                k += width
            }
            continue
        }
        if len(cur) == 0 {
            cur = w
        } else if len(cur) + 1 + len(w) <= width {
            cur = cur + " " + w
        } else {
            lines.push(cur)
            cur = w
        }
    }
    if len(cur) > 0 { lines.push(cur) }
    return lines
}

let fill = fn(text, width) {
    if width == null { width = 70 }
    return _join(wrap(text, width), "\n")
}

let _join = fn(parts, sep) {
    let out = ""
    let i = 0
    while i < len(parts) {
        if i > 0 { out = out + sep }
        out = out + str(parts[i])
        i += 1
    }
    return out
}

let dedent = fn(text) {
    let lines = text.split("\n")
    let margin = null
    for line in lines {
        if len(line.strip()) == 0 { continue }
        let k = 0
        while k < len(line) and (line[k] == " " or line[k] == "\t") {
            k += 1
        }
        if margin == null or k < margin { margin = k }
    }
    if margin == null or margin == 0 { return text }
    let out = []
    for line in lines {
        if len(line.strip()) == 0 {
            out.push("")
        } else {
            out.push(line[margin:])
        }
    }
    return _join(out, "\n")
}

let indent = fn(text, prefix) {
    if prefix == null { prefix = "    " }
    let out = []
    for line in text.split("\n") {
        if len(line.strip()) == 0 {
            out.push(line)
        } else {
            out.push(prefix + line)
        }
    }
    return _join(out, "\n")
}

let shorten = fn(text, width) {
    let placeholder = "..."
    let flat = _join(_words(text), " ")
    if len(flat) <= width { return flat }
    let budget = width - len(placeholder)
    if budget <= 0 { return placeholder[:width] }
    let words = _words(flat)
    let out = ""
    for w in words {
        let cand = out
        if len(cand) > 0 { cand = cand + " " }
        cand = cand + w
        if len(cand) > budget { break }
        out = cand
    }
    if len(out) == 0 { return flat[:budget] + placeholder }
    return out + placeholder
}
