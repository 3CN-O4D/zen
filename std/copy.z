// Shallow and deep copies in the spirit of Python's `copy`.
//
// `copy(x)` duplicates one level (lists/dicts); `deepcopy(x)` duplicates
// recursively. Primitives (numbers, strings, bools, null) are immutable and
// returned as-is. Cyclic structures are not supported by `deepcopy`.

let shallow = fn(x) {
    if typeof(x) == "list" {
        let out = []
        for v in x { out.push(v) }
        return out
    }
    if typeof(x) == "dict" {
        let out = {}
        for k in x.keys() { out[k] = x.get(k) }
        return out
    }
    return x
}

let deepcopy = fn(x) {
    if typeof(x) == "list" {
        let out = []
        for v in x { out.push(deepcopy(v)) }
        return out
    }
    if typeof(x) == "dict" {
        let out = {}
        for k in x.keys() { out[k] = deepcopy(x.get(k)) }
        return out
    }
    return x
}
