# sys.z — Python-like sys module for Zen
# Wraps Rust-native functions

let argv = cli_args()
let version = "Zen " + zen_version() + " (Rust)"
let platform = os_platform()
let byteorder = "little"
let maxsize = 9223372036854775807
let hexversion = 0

# Python-compatible exit. sys_exit is the canonical implementation and
# routes through the os dict (visible to modules), not the bare `exit`
# native, which is not reliably in scope inside module functions.
func sys_exit(code) {
    os.exit(code)
}

# Alias so sys.exit(code) works like Python.
func exit(code) {
    sys_exit(code)
}

# Python-compatible module search path (a list). Note: module functions
# cannot see module-level `let` variables in Zen, so this must be a
# module-level value, not a function returning one.
let path = ["."]

func getsizeof(obj) {
    let t = typeof(obj)
    if t == "string" {
        return len(obj) + 49
    }
    if t == "list" {
        return len(obj) * 8 + 56
    }
    if t == "dict" {
        return len(obj) * 120 + 240
    }
    if t == "int" {
        return 28
    }
    if t == "float" {
        return 24
    }
    if t == "bool" {
        return 24
    }
    return 0
}

func getrecursionlimit() {
    return 10000
}

func getdefaultencoding() {
    return "utf-8"
}

func getfilesystemencoding() {
    return "utf-8"
}

func intern(s) {
    return s
}

func call_tracing(target, args) {
    return target(args)
}

func settrace(tracefunc) {
}

func gettrace() {
    return null
}

func modules() {
    return {}
}

let executable = "zen"
let stdin = "<stdin>"
let stdout = "<stdout>"
let stderr = "<stderr>"