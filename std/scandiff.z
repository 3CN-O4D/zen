# scandiff.z — scan-result diffing with sqlite state.
#
# Continuous-monitoring story for `nmap` scans: record snapshots, then diff
# them (new/closed ports, changed banners). `diff` is pure and offline;
# `record`/`load`/`compare` persist snapshots in sqlite (in-memory or file).
#
# Scan shape: `{host, ports: [{port, state, service, banner}]}`.
# Diff shape: `{opened, closed, changed}` — lists of `{host, port, ...}`.
#
# Only test systems you own or are authorized to audit.

import sqlite

func _key(host, port) {
    return str(host) + ":" + str(port)
}

func _index(scan) {
    var idx = {}
    for p in scan["ports"] {
        idx[_key(scan["host"], p["port"])] = p
    }
    return idx
}

func diff(old_scan, new_scan) {
    let a = _index(old_scan)
    let b = _index(new_scan)
    var opened = []
    var closed = []
    var changed = []
    for k in b.keys() {
        if not a.has(k) {
            opened.push({host: new_scan["host"], port: b[k]["port"], state: b[k]["state"], service: b[k]["service"]})
        } elif a[k]["state"] != b[k]["state"] or a[k]["service"] != b[k]["service"] or a[k]["banner"] != b[k]["banner"] {
            changed.push({host: new_scan["host"], port: b[k]["port"], before: a[k], after: b[k]})
        }
    }
    for k in a.keys() {
        if not b.has(k) {
            closed.push({host: old_scan["host"], port: a[k]["port"], state: a[k]["state"], service: a[k]["service"]})
        }
    }
    return {opened: opened, closed: closed, changed: changed}
}

func record(h, label, scan) {
    sqlite.exec(h, "CREATE TABLE IF NOT EXISTS scans (label TEXT, taken INTEGER, host TEXT, port INTEGER, state TEXT, service TEXT, banner TEXT)")
    let taken = int(time.now())
    var n = 0
    for p in scan["ports"] {
        sqlite.exec(h, "INSERT INTO scans VALUES (?, ?, ?, ?, ?, ?, ?)",
            [label, taken, scan["host"], p["port"], p["state"], p["service"], p["banner"]])
        n += 1
    }
    return n
}

func restore(h, label) {
    let rows = sqlite.query(h, "SELECT host, port, state, service, banner FROM scans WHERE label = ? ORDER BY port", [label])
    if len(rows) == 0 { throw "scandiff.restore: no snapshot labelled: " + str(label) }
    var ports = []
    for r in rows {
        ports.push({port: r["port"], state: r["state"], service: r["service"], banner: r["banner"]})
    }
    return {host: rows[0]["host"], ports: ports}
}

func compare(h, old_label, new_label) {
    return diff(restore(h, old_label), restore(h, new_label))
}
