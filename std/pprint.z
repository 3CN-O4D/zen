// Pretty-printing in the spirit of Python's `pprint`.
//
// `pformat(v)` renders nested lists/dicts/strings with indentation;
// `pprint(v)` prints it. Strings render quoted, dict keys sort for stable
// output, and anything else falls back to `str()`.

let _pad = fn(depth) {
    let out = ""
    let i = 0
    while i < depth * 2 {
        out = out + " "
        i += 1
    }
    return out
}

let _join = fn(parts, sep) {
    let out = ""
    let i = 0
    while i < len(parts) {
        if i > 0 { out = out + sep }
        out = out + parts[i]
        i += 1
    }
    return out
}

let _quote = fn(s) {
    return "'" + s.replace("\\", "\\\\").replace("'", "\\'") + "'"
}

let _sorted_keys = fn(d) {
    // Insertion sort by string form, keeping the original key values (dict
    // keys are not necessarily strings).
    let ks = []
    for k in d.keys() { ks.push(k) }
    let i = 1
    while i < len(ks) {
        let cur = ks[i]
        let j = i
        while j > 0 and str(ks[j - 1]) > str(cur) {
            ks[j] = ks[j - 1]
            j -= 1
        }
        ks[j] = cur
        i += 1
    }
    return ks
}

let _fmt = fn(v, depth) {
    if typeof(v) == "string" { return _quote(v) }
    if typeof(v) == "list" {
        if len(v) == 0 { return "[]" }
        let parts = []
        for x in v { parts.push(_fmt(x, depth + 1)) }
        if len(parts) <= 4 {
            return "[" + _join(parts, ", ") + "]"
        }
        return "[\n" + _pad(depth + 1) + _join(parts, ",\n" + _pad(depth + 1)) + "\n" + _pad(depth) + "]"
    }
    if typeof(v) == "dict" {
        if len(v.keys()) == 0 { return "{}" }
        let parts = []
        for k in _sorted_keys(v) {
            let ks = k
            if typeof(k) != "string" { ks = str(k) } else { ks = _quote(k) }
            parts.push(ks + ": " + _fmt(v.get(k), depth + 1))
        }
        if len(parts) <= 4 {
            return "{" + _join(parts, ", ") + "}"
        }
        return "{\n" + _pad(depth + 1) + _join(parts, ",\n" + _pad(depth + 1)) + "\n" + _pad(depth) + "}"
    }
    return str(v)
}

let pformat = fn(v) {
    return _fmt(v, 0)
}

let pp = fn(v) {
    print pformat(v)
    return null
}
