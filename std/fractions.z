// Exact rational arithmetic in the spirit of Python's `fractions`.
//
// `Fraction(n, d)` builds a normalized fraction (denominator always
// positive, terms divided by their gcd). Arithmetic returns new fractions;
// compare with `eq`, render with `show`, convert with `to_float`.

let _abs = fn(x) {
    if x < 0 { return -x }
    return x
}

let _gcd = fn(a, b) {
    a = _abs(a)
    b = _abs(b)
    while b != 0 {
        let t = a % b
        a = b
        b = t
    }
    return a
}

class Fraction {
    var n
    var d

    func init(num, den) {
        if den == null { den = 1 }
        if den == 0 { throw "zero denominator" }
        let g = _gcd(num, den)
        n = int(num / g)
        d = int(den / g)
        if d < 0 {
            n = -n
            d = -d
        }
    }

    func show() {
        if d == 1 { return str(n) }
        return str(n) + "/" + str(d)
    }

    func to_float() {
        return n / d
    }

    func eq(o) {
        return n == o.n and d == o.d
    }

    func neg() {
        return Fraction(-n, d)
    }

    func inv() {
        return Fraction(d, n)
    }

    func add(o) {
        return Fraction(n * o.d + o.n * d, d * o.d)
    }

    func sub(o) {
        return Fraction(n * o.d - o.n * d, d * o.d)
    }

    func mul(o) {
        return Fraction(n * o.n, d * o.d)
    }

    func div(o) {
        return Fraction(n * o.d, d * o.n)
    }
}

func Fraction(num, den) {
    return new Fraction(num, den)
}
