# hashid.z — identify likely hash algorithms from a hash string.
#
# Offline recon helper in the spirit of hashID: exact-length hex digests and
# `$`-prefixed modular-crypt formats map to candidate algorithms with a
# confidence level. Ambiguous lengths (md5 vs ntlm, sha256 vs sha3-256) return
# every candidate honestly — the module never silently picks one.
#
# Only test systems you own or are authorized to audit.

func _all_in(s, alphabet) {
    if len(s) == 0 { return false }
    for c in list(s) {
        if alphabet.contains(c) { } else { return false }
    }
    return true
}

func _is_hex(s) {
    return _all_in(s, "0123456789abcdefABCDEF")
}

func _hex_candidates(n) {
    if n == 32 {
        return [
            {name: "md5", bits: 128, encoding: "hex", confidence: "medium", reason: "32 hex chars; same length as ntlm/md4"},
            {name: "ntlm", bits: 128, encoding: "hex", confidence: "medium", reason: "32 hex chars; same length as md5/md4"},
            {name: "md4", bits: 128, encoding: "hex", confidence: "medium", reason: "32 hex chars; same length as md5/ntlm"},
        ]
    }
    if n == 40 {
        return [
            {name: "sha1", bits: 160, encoding: "hex", confidence: "high", reason: "40 hex chars"},
            {name: "ripemd160", bits: 160, encoding: "hex", confidence: "medium", reason: "40 hex chars; same length as sha1"},
        ]
    }
    if n == 56 {
        return [{name: "sha224", bits: 224, encoding: "hex", confidence: "high", reason: "56 hex chars"}]
    }
    if n == 64 {
        return [
            {name: "sha256", bits: 256, encoding: "hex", confidence: "high", reason: "64 hex chars"},
            {name: "sha3-256", bits: 256, encoding: "hex", confidence: "medium", reason: "64 hex chars; same length as sha256"},
            {name: "blake2s", bits: 256, encoding: "hex", confidence: "medium", reason: "64 hex chars; same length as sha256"},
        ]
    }
    if n == 96 {
        return [
            {name: "sha384", bits: 384, encoding: "hex", confidence: "high", reason: "96 hex chars"},
            {name: "sha3-384", bits: 384, encoding: "hex", confidence: "medium", reason: "96 hex chars; same length as sha384"},
        ]
    }
    if n == 128 {
        return [
            {name: "sha512", bits: 512, encoding: "hex", confidence: "high", reason: "128 hex chars"},
            {name: "sha3-512", bits: 512, encoding: "hex", confidence: "medium", reason: "128 hex chars; same length as sha512"},
            {name: "blake2b", bits: 512, encoding: "hex", confidence: "medium", reason: "128 hex chars; same length as sha512"},
            {name: "whirlpool", bits: 512, encoding: "hex", confidence: "medium", reason: "128 hex chars; same length as sha512"},
        ]
    }
    return []
}

func _modular(v) {
    if v.startswith("$2a$") or v.startswith("$2b$") or v.startswith("$2x$") or v.startswith("$2y$") {
        if len(v) == 60 and _all_in(v.substring(4, len(v)), "./ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789") {
            return [{name: "bcrypt", bits: 192, encoding: "modular", confidence: "high", reason: "$2* prefix with 60-char crypt body"}]
        }
        return [{name: "bcrypt", bits: 192, encoding: "modular", confidence: "medium", reason: "$2* prefix but unexpected length; verify the full hash"}]
    }
    if v.startswith("$1$") {
        return [{name: "md5crypt", bits: 128, encoding: "modular", confidence: "high", reason: "$1$ prefix"}]
    }
    if v.startswith("$apr1$") {
        return [{name: "apr1", bits: 128, encoding: "modular", confidence: "high", reason: "$apr1$ prefix (Apache md5)"}]
    }
    if v.startswith("$5$") {
        return [{name: "sha256crypt", bits: 256, encoding: "modular", confidence: "high", reason: "$5$ prefix"}]
    }
    if v.startswith("$6$") {
        return [{name: "sha512crypt", bits: 512, encoding: "modular", confidence: "high", reason: "$6$ prefix"}]
    }
    if v.startswith("$argon2i$") or v.startswith("$argon2d$") or v.startswith("$argon2id$") {
        return [{name: "argon2", bits: 0, encoding: "modular", confidence: "high", reason: "$argon2* prefix"}]
    }
    return []
}

func identify(s) {
    let v = str(s).strip()
    if v.startswith("$") {
        return _modular(v)
    }
    if _is_hex(v) {
        return _hex_candidates(len(v))
    }
    return []
}

func likely(s) {
    let c = identify(s)
    if len(c) == 0 { return null }
    return c[0]["name"]
}
