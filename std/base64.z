// Pure-Zen reimplementation of the `base64` module.
//
// Declares ZEN_PURE so the .z tier wins over the Rust tier on import; the
// native members stay reachable as `base64.native.*` and setting
// ZEN_NATIVE_ONLY=base64 restores the native tier.
ZEN_PURE = true

let ALPH = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
let INV = {}
let _i = 0
while _i < len(ALPH) {
    INV[ALPH[_i]] = _i
    _i += 1
}

let utf8_bytes = fn(cp) {
    if cp < 128 {
        return [cp]
    }
    if cp < 2048 {
        return [0xC0 | (cp >> 6), 0x80 | (cp & 0x3F)]
    }
    if cp < 65536 {
        return [0xE0 | (cp >> 12), 0x80 | ((cp >> 6) & 0x3F), 0x80 | (cp & 0x3F)]
    }
    return [0xF0 | (cp >> 18), 0x80 | ((cp >> 12) & 0x3F), 0x80 | ((cp >> 6) & 0x3F), 0x80 | (cp & 0x3F)]
}

let is_cont = fn(b) { b >= 0x80 and b <= 0xBF }

let encode = fn(data) {
    let out = ""
    let acc = 0
    let n = 0
    for _ch in list(data) {
        for _b in utf8_bytes(_ch.ord()) {
            acc = acc * 256 + _b
            n += 1
        }
        while n >= 3 {
            let shift = 8 * (n - 3)
            let b = (acc >> shift) & 0xFFFFFF
            out += ALPH[(b >> 18) & 0x3F] + ALPH[(b >> 12) & 0x3F] + ALPH[(b >> 6) & 0x3F] + ALPH[b & 0x3F]
            acc = acc & ((1 << shift) - 1)
            n = n - 3
        }
    }
    if n == 1 {
        let b = acc & 0xFF
        return out + ALPH[b >> 2] + ALPH[(b & 0x03) << 4] + "=="
    }
    if n == 2 {
        let b = acc & 0xFFFF
        return out + ALPH[b >> 10] + ALPH[(b >> 4) & 0x3F] + ALPH[(b & 0x0F) << 2] + "="
    }
    return out
}

let decode = fn(data) {
    let bytes = []
    let acc = 0
    let bits = 0
    for _ch in list(data) {
        if _ch == "=" {
            continue
        }
        let val = INV.get(_ch, -1)
        if val < 0 {
            throw "invalid base64 character: " + _ch
        }
        acc = acc * 64 + val
        bits += 6
        if bits >= 8 {
            bits -= 8
            bytes.push((acc >> bits) & 0xFF)
            acc = acc & ((1 << bits) - 1)
        }
    }
    // Native tier renders the bytes with String::from_utf8_lossy; mirror it
    // so valid UTF-8 round-trips and stray sequences become U+FFFD.
    let out = ""
    let _i = 0
    while _i < len(bytes) {
        let b = bytes[_i]
        if b < 0x80 {
            out += chr(b)
            _i += 1
        } else if b < 0xC2 {
            out += chr(0xFFFD)
            _i += 1
        } else if b < 0xE0 {
            if _i + 1 < len(bytes) and is_cont(bytes[_i + 1]) {
                out += chr(((b & 0x1F) << 6) | (bytes[_i + 1] & 0x3F))
                _i += 2
            } else {
                out += chr(0xFFFD)
                _i += 1
            }
        } else if b < 0xF0 {
            if _i + 2 < len(bytes) and is_cont(bytes[_i + 1]) and is_cont(bytes[_i + 2]) {
                out += chr(((b & 0x0F) << 12) | ((bytes[_i + 1] & 0x3F) << 6) | (bytes[_i + 2] & 0x3F))
                _i += 3
            } else {
                out += chr(0xFFFD)
                _i += 1
            }
        } else if b < 0xF5 {
            if _i + 3 < len(bytes) and is_cont(bytes[_i + 1]) and is_cont(bytes[_i + 2]) and is_cont(bytes[_i + 3]) {
                out += chr(((b & 0x07) << 18) | ((bytes[_i + 1] & 0x3F) << 12) | ((bytes[_i + 2] & 0x3F) << 6) | (bytes[_i + 3] & 0x3F))
                _i += 4
            } else {
                out += chr(0xFFFD)
                _i += 1
            }
        } else {
            out += chr(0xFFFD)
            _i += 1
        }
    }
    return out
}

let url_encode = fn(data) {
    let s = encode(data)
    let out = ""
    for _c in list(s) {
        if _c == "+" {
            out += "-"
        } else if _c == "/" {
            out += "_"
        } else if _c != "=" {
            out += _c
        }
    }
    return out
}

let url_decode = fn(data) {
    let s = ""
    for _c in list(data) {
        if _c == "-" {
            s += "+"
        } else if _c == "_" {
            s += "/"
        } else {
            s += _c
        }
    }
    return decode(s)
}