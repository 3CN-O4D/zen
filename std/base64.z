// Pure-Zen reimplementation of the `base64` module.
//
// Declares ZEN_PURE so the .z tier wins over the Rust tier on import; the
// native members stay reachable as `base64.native.*` and setting
// ZEN_NATIVE_ONLY=base64 restores the native tier.
ZEN_PURE = true
import bytes
let u8 = bytes.utf8_bytes
let sfb = bytes.str_from_bytes

let ALPH = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
let INV = {}
let _i = 0
while _i < len(ALPH) {
    INV[ALPH[_i]] = _i
    _i += 1
}

let encode = fn(data) {
    let out = ""
    let acc = 0
    let n = 0
    for _ch in list(data) {
        for _b in u8(_ch.ord()) {
            acc = acc * 256 + _b
            n += 1
        }
        while n >= 3 {
            let shift = 8 * (n - 3)
            let b = (acc >> shift) & 0xFFFFFF
            out += ALPH[(b >> 18) & 0x3F] + ALPH[(b >> 12) & 0x3F] + ALPH[(b >> 6) & 0x3F] + ALPH[b & 0x3F]
            acc = acc & ((1 << shift) - 1)
            n = n - 3
        }
    }
    if n == 1 {
        let b = acc & 0xFF
        return out + ALPH[b >> 2] + ALPH[(b & 0x03) << 4] + "=="
    }
    if n == 2 {
        let b = acc & 0xFFFF
        return out + ALPH[b >> 10] + ALPH[(b >> 4) & 0x3F] + ALPH[(b & 0x0F) << 2] + "="
    }
    return out
}

let decode = fn(data) {
    let bl = []
    let acc = 0
    let bits = 0
    for _ch in list(data) {
        if _ch == "=" {
            continue
        }
        let val = INV.get(_ch, -1)
        if val < 0 {
            throw "invalid base64 character: " + _ch
        }
        acc = acc * 64 + val
        bits += 6
        if bits >= 8 {
            bits -= 8
            bl.push((acc >> bits) & 0xFF)
            acc = acc & ((1 << bits) - 1)
        }
    }
    return sfb(bl)
}

let url_encode = fn(data) {
    let s = encode(data)
    let out = ""
    for _c in list(s) {
        if _c == "+" {
            out += "-"
        } else if _c == "/" {
            out += "_"
        } else if _c != "=" {
            out += _c
        }
    }
    return out
}

let url_decode = fn(data) {
    let s = ""
    for _c in list(data) {
        if _c == "-" {
            s += "+"
        } else if _c == "_" {
            s += "/"
        } else {
            s += _c
        }
    }
    return decode(s)
}