# argparser.z — command-line argument parsing for Zen

class ArgumentParser {
    var _description
    var _positional = []
    var _optional = []

    func init(description) {
        _description = description
        return self
    }

    func _strip(name) {
        while name.length > 0 && (name[0, 1] == "-") {
            name = name[1, name.length]
        }
        return name
    }

    func add_argument(name, action = null, type = null, default_value = null, help = null) {
        let stripped = _strip(name)
        let arg = {
            name: stripped,
            action: action,
            type: type,
            default_value: default_value,
            help: help,
        }
        if name.startsWith("-") {
            _optional.push(arg)
        } else {
            _positional.push(arg)
        }
        return self
    }

    func _index_of(lst, val) {
        var i = 0
        while i < len(lst) {
            if lst[i] == val {
                return i
            }
            i += 1
        }
        return null
    }

    func parse_args() {
        let args = {}
        let args_list = cli_args()

        for arg in _positional {
            let name = arg.name
            let found = false
            for a in args_list {
                if a == name {
                    let idx = _index_of(args_list, name)
                    if idx != null && idx + 1 < len(args_list) {
                        args[name] = args_list[idx + 1]
                        found = true
                        break
                    }
                }
            }
            if !found && arg.default_value != null {
                args[name] = arg.default_value
            }
        }

        for arg in _optional {
            let name = arg.name
            let long_name = "--" + name
            let short_name = "-" + name[0, 1]

            let found = false
            var idx = _index_of(args_list, long_name)
            if idx == null {
                idx = _index_of(args_list, short_name)
            }
            if idx != null {
                found = true
                if arg.action == "store_true" {
                    args[name] = true
                } elif arg.action == "store_false" {
                    args[name] = false
                } elif idx + 1 < len(args_list) {
                    let val = args_list[idx + 1]
                    if arg.type == "int" {
                        args[name] = int(val)
                    } elif arg.type == "float" {
                        args[name] = float(val)
                    } else {
                        args[name] = val
                    }
                }
            }
            if !found && arg.action == "store_true" {
                args[name] = true
            } elif !found && arg.action == "store_false" {
                args[name] = false
            } elif !found && arg.default_value != null {
                args[name] = arg.default_value
            }
        }

        return args
    }
}

func ArgumentParser(description) {
    return new ArgumentParser(description)
}