# argparser.z — command-line argument parsing for Zen
#
# Usage:
#   import argparser
#   let p = argparser.ArgumentParser("my tool")
#   p.add_argument("input")                              # positional
#   p.add_argument("--verbose", {action: "store_true"})  # boolean flag
#   p.add_argument("--outfile", {short: "-o", value: "output.txt"})
#   p.add_argument("--count", {type: "int", value: 0})
#   let args = p.parse_args()
#   # args.input, args.verbose, args.outfile, args.count
#
# Config keys for optional args:
#   action: "store_true" / "store_false" (boolean flags, no value needed)
#   type:   "int" / "float" (auto-convert the next token)
#   value:  default value if flag not provided
#   short:  short flag name, e.g. "-o"
#   help:   description string for help text
#
# help() works on the module or ArgumentParser class:
#   help(argparser)

class ArgumentParser {
    var _description
    var _positional = []
    var _optional = []

    func init(description) {
        _description = description
        return self
    }

    func _strip(name) {
        while name.length > 0 && (name[0, 1] == "-") {
            name = name[1, name.length]
        }
        return name
    }

    func add_argument(name, config = null) {
        let stripped = _strip(name)
        let arg = {
            name: stripped,
            long: "--" + stripped,
            short: null,
            action: null,
            type: null,
            value: null,
            help: null,
        }
        if config != null {
            if config.has("action") {
                arg.action = config.get("action")
            }
            if config.has("type") {
                arg.type = config.get("type")
            }
            if config.has("value") {
                arg.value = config.get("value")
            }
            if config.has("help") {
                arg.help = config.get("help")
            }
            if config.has("short") {
                arg.short = config.get("short")
            }
        }
        if name.startsWith("-") {
            _optional.push(arg)
        } else {
            _positional.push(arg)
        }
        return self
    }

    func parse_args() {
        let result = {}
        let raw = cli_args()
        var i = 2

        # first pass: consume optional flags, collect positional candidates
        let positional_vals = []
        while i < len(raw) {
            let token = raw[i]
            if token.startsWith("--") {
                let matched = _match_long(token, raw, i)
                if matched != null {
                    result[matched.name] = matched.value
                    if matched.consumed > 1 {
                        i = i + matched.consumed
                    } else {
                        i = i + 1
                    }
                } else {
                    i = i + 1
                }
            } elif token.startsWith("-") && token.length == 2 {
                let matched = _match_short(token, raw, i)
                if matched != null {
                    result[matched.name] = matched.value
                    if matched.consumed > 1 {
                        i = i + matched.consumed
                    } else {
                        i = i + 1
                    }
                } else {
                    i = i + 1
                }
            } else {
                positional_vals.push(token)
                i = i + 1
            }
        }

        # second pass: assign positional args in order
        var pi = 0
        for arg in _positional {
            if pi < len(positional_vals) {
                result[arg.name] = positional_vals[pi]
                pi = pi + 1
            } elif arg.value != null {
                result[arg.name] = arg.value
            }
        }

        # fill defaults for missing optional args
        for arg in _optional {
            if !result.has(arg.name) {
                if arg.action == "store_true" {
                    result[arg.name] = false
                } elif arg.action == "store_false" {
                    result[arg.name] = true
                } elif arg.value != null {
                    result[arg.name] = arg.value
                }
            }
        }

        return result
    }

    func _match_long(token, raw, pos) {
        for arg in _optional {
            if arg.long == token {
                if arg.action == "store_true" {
                    return {name: arg.name, value: true, consumed: 1}
                } elif arg.action == "store_false" {
                    return {name: arg.name, value: false, consumed: 1}
                } elif pos + 1 < len(raw) {
                    let v = raw[pos + 1]
                    if arg.type == "int" {
                        return {name: arg.name, value: int(v), consumed: 2}
                    } elif arg.type == "float" {
                        return {name: arg.name, value: float(v), consumed: 2}
                    } else {
                        return {name: arg.name, value: v, consumed: 2}
                    }
                }
            }
        }
        return null
    }

    func _match_short(token, raw, pos) {
        for arg in _optional {
            if arg.short == token {
                if arg.action == "store_true" {
                    return {name: arg.name, value: true, consumed: 1}
                } elif arg.action == "store_false" {
                    return {name: arg.name, value: false, consumed: 1}
                } elif pos + 1 < len(raw) {
                    let v = raw[pos + 1]
                    if arg.type == "int" {
                        return {name: arg.name, value: int(v), consumed: 2}
                    } elif arg.type == "float" {
                        return {name: arg.name, value: float(v), consumed: 2}
                    } else {
                        return {name: arg.name, value: v, consumed: 2}
                    }
                }
            }
        }
        return null
    }
}

func ArgumentParser(description) {
    return new ArgumentParser(description)
}

