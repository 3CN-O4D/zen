// Binary-heap operations in the spirit of Python's `heapq`.
//
// Zen passes arguments by value, so in-place mutation cannot propagate back
// to the caller: every function here takes a heap and RETURNS the updated
// heap (rebind it: `let h = heapq.heappush(h, x)`). `heappop` returns a
// `[top, heap]` pair for the same reason. Heaps are plain ascending lists
// where `h[0]` is always the smallest element.

// NOTE: call arguments arrive by value, so the sift helpers take the heap
// and RETURN it; callers rebind (`h = _siftdown(h, i)`). Mutating a parameter
// in place never reaches the caller.
let _siftup = fn(h, i) {
    while i > 0 {
        let parent = int((i - 1) / 2)
        if h[i] < h[parent] {
            let t = h[i]
            h[i] = h[parent]
            h[parent] = t
            i = parent
        } else {
            break
        }
    }
    return h
}

let _siftdown = fn(h, i) {
    let n = len(h)
    while true {
        let left = i * 2 + 1
        let right = i * 2 + 2
        let smallest = i
        if left < n and h[left] < h[smallest] { smallest = left }
        if right < n and h[right] < h[smallest] { smallest = right }
        if smallest == i { break }
        let t = h[i]
        h[i] = h[smallest]
        h[smallest] = t
        i = smallest
    }
    return h
}

let heappush = fn(h, x) {
    h.push(x)
    return _siftup(h, len(h) - 1)
}

let heappop = fn(h) {
    if len(h) == 0 { throw "heappop from empty heap" }
    let top = h[0]
    let last = h.pop()
    if len(h) > 0 {
        h[0] = last
        h = _siftdown(h, 0)
    }
    return [top, h]
}

let heapify = fn(items) {
    let h = []
    for x in items { h.push(x) }
    let i = int(len(h) / 2) - 1
    while i >= 0 {
        h = _siftdown(h, i)
        i -= 1
    }
    return h
}

let heapreplace = fn(h, x) {
    if len(h) == 0 { throw "heapreplace on empty heap" }
    let top = h[0]
    h[0] = x
    return [top, _siftdown(h, 0)]
}

let heappushpop = fn(h, x) {
    if len(h) > 0 and x > h[0] {
        let top = h[0]
        h[0] = x
        return [top, _siftdown(h, 0)]
    }
    return [x, h]
}

let nsmallest = fn(n, items) {
    let h = heapify(items)
    let out = []
    let k = 0
    while k < n and len(h) > 0 {
        let r = heappop(h)
        out.push(r[0])
        h = r[1]
        k += 1
    }
    return out
}

let nlargest = fn(n, items) {
    // Negation-free order flip: repeatedly take the max by scanning. For
    // comparable numbers this matches Python's nlargest without a key fn.
    let rest = []
    for x in items { rest.push(x) }
    let out = []
    let k = 0
    while k < n and len(rest) > 0 {
        let bi = 0
        let j = 1
        while j < len(rest) {
            if rest[j] > rest[bi] { bi = j }
            j += 1
        }
        out.push(rest[bi])
        let kept = []
        let m = 0
        while m < len(rest) {
            if m != bi { kept.push(rest[m]) }
            m += 1
        }
        rest = kept
        k += 1
    }
    return out
}
