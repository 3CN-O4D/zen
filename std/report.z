# report.z — findings to Markdown/HTML reports.
#
# Collects `{severity, title, detail, evidence, remediation}` findings (as
# produced by `tlscheck.assess`) and renders a Markdown or HTML report with
# a severity summary. Pure offline, pure Zen.
#
# Only test systems you own or are authorized to audit.

import fs

func _rank(severity) {
    if severity == "critical" { return 0 }
    if severity == "high" { return 1 }
    if severity == "medium" { return 2 }
    if severity == "low" { return 3 }
    if severity == "info" { return 4 }
    throw "report: unknown severity: " + str(severity)
}

func _escape(s) {
    var out = ""
    for c in list(str(s)) {
        if c == "&" { out += "&amp;" }
        elif c == "<" { out += "&lt;" }
        elif c == ">" { out += "&gt;" }
        elif c == "\"" { out += "&quot;" }
        else { out += c }
    }
    return out
}

func _sorted(findings) {
    var rest = []
    for f in findings { rest.push(f) }
    var out = []
    while len(rest) > 0 {
        var bi = 0
        var i = 1
        while i < len(rest) {
            if _rank(rest[i]["severity"]) < _rank(rest[bi]["severity"]) { bi = i }
            i += 1
        }
        out.push(rest[bi])
        var nxt = []
        var j = 0
        while j < len(rest) {
            if j != bi { nxt.push(rest[j]) }
            j += 1
        }
        rest = nxt
    }
    return out
}

func _counts(findings) {
    var c = {critical: 0, high: 0, medium: 0, low: 0, info: 0}
    for f in findings {
        let s = f["severity"]
        c[s] = c[s] + 1
    }
    return c
}

func summary_of(findings) {
    let c = _counts(findings)
    return {total: len(findings), critical: c["critical"], high: c["high"], medium: c["medium"], low: c["low"], info: c["info"]}
}

func render_markdown(title, findings) {
    let s = summary_of(findings)
    var out = "# " + title + "\n\n"
    out += "Findings: " + str(s["total"]) + " (critical " + str(s["critical"]) + ", high " + str(s["high"]) + ", medium " + str(s["medium"]) + ", low " + str(s["low"]) + ", info " + str(s["info"]) + ")\n\n"
    for f in _sorted(findings) {
        out += "## [" + f["severity"] + "] " + f["title"] + "\n\n"
        out += f["detail"] + "\n\n"
        if f["evidence"] != "" { out += "Evidence: " + f["evidence"] + "\n\n" }
        if f["remediation"] != "" { out += "Remediation: " + f["remediation"] + "\n\n" }
    }
    return out
}

func render_html(title, findings) {
    let s = summary_of(findings)
    var out = "<html><head><meta charset=\"utf-8\"><title>" + _escape(title) + "</title></head><body>\n"
    out += "<h1>" + _escape(title) + "</h1>\n"
    out += "<p>Findings: " + str(s["total"]) + " (critical " + str(s["critical"]) + ", high " + str(s["high"]) + ", medium " + str(s["medium"]) + ", low " + str(s["low"]) + ", info " + str(s["info"]) + ")</p>\n"
    out += "<table border=\"1\"><tr><th>Severity</th><th>Title</th><th>Detail</th><th>Remediation</th></tr>\n"
    for f in _sorted(findings) {
        out += "<tr><td>" + f["severity"] + "</td><td>" + _escape(f["title"]) + "</td><td>" + _escape(f["detail"]) + "</td><td>" + _escape(f["remediation"]) + "</td></tr>\n"
    }
    return out + "</table></body></html>\n"
}

func create(title) {
    # `findings` is a list, and lists are reference-typed: every closure
    # below observes the same storage (see hashlib.z for the pattern).
    let findings = []
    let r = {}
    r["title"] = title
    r["add"] = fn(severity, ftitle, detail, evidence = "", remediation = "") {
        let rank = _rank(severity)
        findings.push({severity: severity, title: ftitle, detail: detail, evidence: evidence, remediation: remediation})
        return rank
    }
    r["extend"] = fn(items) {
        for f in items { findings.push(f) }
        return len(findings)
    }
    r["summary"] = fn() { return summary_of(findings) }
    r["markdown"] = fn() { return render_markdown(title, findings) }
    r["html"] = fn() { return render_html(title, findings) }
    r["save"] = fn(path, format = "markdown") {
        if format == "html" { fs.write(path, render_html(title, findings)) } else { fs.write(path, render_markdown(title, findings)) }
        return path
    }
    return r
}
