{
  "name": "Zen",
  "scopeName": "source.zen",
  "fileTypes": ["z"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#strings" },
    { "include": "#template-literals" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#functions" },
    { "include": "#variables" },
    { "include": "#types" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.zen", "match": "//[^\n]*" },
        { "name": "comment.line.number-sign.zen", "match": "#[^\n]*" },
        { "name": "comment.block.zen", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.zen",
          "match": "\\b(if|elif|else|for|in|while|switch|case|default|break|continue|return|try|catch|finally|with|as|load|use)\\b"
        },
        {
          "name": "keyword.declaration.zen",
          "match": "\\b(let|const|function|def|class|extends|new|lambda)\\b"
        },
        {
          "name": "keyword.other.zen",
          "match": "\\b(go|fill|click|wait|wait_for|shot|scroll|execute|download|refresh|back|forward|print|input|include|throw|raise|assert)\\b"
        },
        {
          "name": "keyword.operator.logical.zen",
          "match": "\\b(and|or|not|is|typeof)\\b"
        },
        {
          "name": "variable.language.zen",
          "match": "\\b(self)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.zen",
          "match": "\\b(true|false|null)\\b"
        },
        {
          "name": "variable.language.special.zen",
          "match": "\\b(_url|__url|___url|_time|_date|_dir|_version|_|_timeout|error)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.double.zen",
          "begin": " \"\"\"",
          "end": "\"\"\""
        },
        {
          "name": "string.quoted.triple.single.zen",
          "begin": " '''",
          "end": "'''"
        },
        {
          "name": "string.quoted.double.zen",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.zen",
              "match": "\\\\(?:[\"'\\\\ntr0]|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4}|U[0-9a-fA-F]{8})"
            },
            {
              "name": "variable.other.interpolated.zen",
              "begin": "\\{",
              "end": "\\}",
              "patterns": [
                { "include": "source.zen" }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.single.zen",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.zen",
              "match": "\\\\(?:[\"'\\\\ntr0]|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4}|U[0-9a-fA-F]{8})"
            }
          ]
        }
      ]
    },
    "template-literals": {
      "patterns": [
        {
          "name": "string.template.zen",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "name": "variable.other.template.zen",
              "begin": "\\$\\{",
              "end": "\\}",
              "patterns": [
                { "include": "source.zen" }
              ]
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.zen",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.zen",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.zen",
          "match": "===|!==|==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.arithmetic.zen",
          "match": "\\*\\*|\\+\\+|--|\\+=|-=|\\*=|/=|%=|\\?\\?=|\\?\\?|\\bin\\b|\\bnot\\bin\\b"
        },
        {
          "name": "keyword.operator.assignment.zen",
          "match": "=|\\+=|-=|\\*=|/=|%=|\\?\\?="
        },
        {
          "name": "keyword.operator.range.zen",
          "match": "->|\\.\\.|\\bto\\b"
        },
        {
          "name": "keyword.operator.spread.zen",
          "match": "\\.\\.\\."
        },
        {
          "name": "keyword.operator.safe.zen",
          "match": "\\?\\."
        },
        {
          "name": "keyword.operator.bitwise.zen",
          "match": "&|\\||\\^|~|<<|>>"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.zen",
          "match": "\\b(find|find_all|find_by_text|find_by_url|first|search|go|fill|click|wait|wait_for|wait_for_network|shot|scroll_to|execute|download|set_user_agent|set_headers|user_agent|headers|page_html|page_text|page_links|page_images|page_forms|page_inputs|page_buttons|read_file|write_file|append_file|read_binary|write_binary|file_exists|list_dir|mkdir|remove_file|path_join|basename|dirname|input|prompt|confirm|exec|range|interval|enumerate|zip|map|filter|reduce|flatten|unique|chunk|partition|lines|slugify|truncate|strip_tags|escape_html|to_csv|merge|pick|omit|invert|assertEq|assert|summary)\\b"
        },
        {
          "name": "support.function.builtin.zen",
          "match": "\\b(abs|min|max|len|type|str|int|float|bool|round|trunc|print|input|sleep|random|json_parse|json_encode|csv_read|csv_write|csv_parse|csv_encode)\\b"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.zen",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.zen",
          "match": "\\b(ZenElement|ZenList|ZenDict|ZenRegexMatch|ZenHttpResponse)\\b"
        }
      ]
    }
  }
}
