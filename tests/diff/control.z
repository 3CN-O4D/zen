# Differential probe: control flow.
var x = 5
if x > 10 {
    print("big")
} elif x == 5 {
    print("five")
} else {
    print("other")
}

var i = 0
var total = 0
while i < 5 {
    total = total + i
    i = i + 1
}
print(total)

var first_big = 0
for v in [1, 50, 500] {
    if v > 100 { break }
    first_big = v
}
print(first_big)

var odd = 0
var j = 0
while j < 10 {
    j = j + 1
    if j % 2 == 0 { continue }
    odd = odd + j
}
print(odd)

var sum = 0
for v in [1, 2, 3, 4] {
    sum = sum + v
}
print(sum)

# ── multi-variable for: each variable binds one element of the yielded item ──
var total = 0
for a, b in [[1, 2], [3, 4]] {
    total = total + a * b
}
print(total)

# Tuples unpack the same way.
var sums = ""
for a, b, c in [(1, 2, 3), (4, 5, 6)] {
    sums = sums + str(a + b + c)
}
print(sums)

# Strings unpack per character.
var chars = ""
for a, b in ["ab", "cd"] {
    chars = chars + a + b
}
print(chars)

# Extra elements are ignored.
var extra = ""
for a, b in [[1, 2, 3]] {
    extra = str(a) + str(b)
}
print(extra)

# A short item raises ValueError before anything is bound; the loop then keeps
# going with the next item.
var caught = ""
for bad in [[1], [2, 3]] {
    try {
        for a, b in [bad] {
            caught = caught + "b"
        }
    } catch ValueError {
        caught = caught + "v"
    }
}
print(caught)

# A non-sequence item is short too.
var short = ""
try {
    for a, b in [5] {
        short = "no"
    }
} catch ValueError {
    short = "v"
}
print(short)

# Two variables over an empty run never execute the body.
var empty = ""
for a, b in [] {
    empty = "x"
}
print(empty == "")

# enumerate() and .items() feed the two-variable form directly.
for i, item in enumerate(["x", "y"]) {
    print(str(i) + ":" + item)
}
for key, value in {a: 1, b: 2}.items() {
    print(key + "=" + str(value))
}

# break/continue still retire the loop correctly with several variables.
var seen = ""
for a, b in [[1, 2], [3, 4], [5, 6]] {
    if a == 3 { continue }
    if a == 5 { break }
    seen = seen + str(a) + str(b)
}
print(seen)

# ── range: `->` and `..` both build an inclusive list of ints ──
var r = 2 -> 5
var s = ""
for v in r { s = s + str(v) }
print(s)
print(len(1 .. 5))
print(len(5 -> 1))
print(len(4 -> 4))
print(len(0 -> 10))
var typed = 1 -> 2
print(type(typed[0]))
try { print(1.5 -> 3) } catch TypeError { print("TypeError") }
try { print("a" -> 3) } catch TypeError { print("TypeError") }

# ── list comprehension ──
var squares = [x * x for x in 1 -> 5]
print(squares)
print([x for x in 1 -> 10 if x % 2 == 0])
print([cell for row in [[1, 2], [3, 4]] for cell in row])
print([x.upper() for x in ["alice", "bob"]])

# The clause variable is scoped to the comprehension.
var x = 99
print([x for x in 1 -> 3])
print(x)

# A comprehension can read the enclosing scope, and an inner clause can read
# the outer clause's variable.
var limit = 3
print([n for n in 1 -> 6 if n < limit])
print([[y for y in 1 -> n] for n in 1 -> 3])
print(len([a for a in 1 -> 4 if a % 2 == 0 for b in 1 -> 2]))

# The iterable is evaluated once per clause, and once per outer iteration for
# a nested clause.
var calls = 0
func source() { calls = calls + 1
 return [1, 2] }
print([v for v in source()])
print(calls)

# Iteration follows the same protocol as `for`: a dict yields keys.
print([k for k in {a: 1, b: 2}])
print(len([v for v in []]))
print(len([v for v in 7]))
print(len([c for c in "hey"]))
var acc = [1]
print(len([v for v in acc]))

# ── higher-order methods: the callback trampoline ──
let double = (x) => x * 2
var nums = [1, 2, 3, 4, 5]
print(nums.map(double))
print(nums.filter((x) => x % 2 == 0))
print(nums.reduce((acc, x) => acc + x))
print(nums.reduce((acc, x) => acc + x, 100))
print(nums.each((x) => x))
print(nums.for_each((x) => x))

# Callbacks may be stateful closures and may call back into Zen code.
var seen = 0
var log = []
for v in nums.map((x) => { seen = seen + 1
 log.push(x * 10)
 x + 1 }) {
    print(v)
}
print(seen)
print(log)

# A `try` inside the callback is handled by the callback, and an unhandled
# error escapes to the caller's handler.
var handled = [1, 0, 2].map((x) => { if x == 0 { return 99 }
 x * 10 })
print(handled)
var caught = ""
try {
    nums.map((x) => { if x == 3 { throw "boom" }
 x })
} catch {
    caught = caught + "t"
}
print(caught == "t")
# `catch <Kind>` filters on the error kind, and an unhandled callback error
# unwinds into the caller's handler.
var caught_math = 0
try {
    nums.map((x) => { if x == 2 { return 1 / 0 }
 x })
} catch ZeroDivisionError {
    caught_math = caught_math + 1
}
print(caught_math)
# `catch as e` binds the error message instead of filtering on the kind.
var msg = ""
try {
    return 1 / 0
} catch as e {
    msg = e
}
print(msg)
# The wrong kind name does not catch.
var wrong = 0
try {
    try {
        return 1 / 0
    } catch ZeroDivisionError {
        wrong = wrong + 1
    }
} catch {
    wrong = wrong + 100
}
print(wrong)

# map/filter/reduce iterate any iterable, exactly like the oracle.
print([1, 2].map((x) => x + 1))
print([1, 2].reduce((a, b) => a * b))
print(len([].reduce((a, b) => a + b, 7)))
try { [].reduce((a, b) => a + b) } catch ValueError { print("ValueError") }
var mapped = ""
for c in "ab".map((c) => c.upper()) { mapped = mapped + c }
print(mapped)
var keys = []
{k: 1, b: 2}.keys().each((k) => keys.push(k))
print(keys)

# A user type's own method of the same name still wins over the builtin.
class Doubler {
    func map(f) { return "instance map" }
}
print(Doubler().map(double))

# ── arrow functions with a block body auto-return the trailing expression ──
let arrow = (x) => { let doubled = x * 2
 doubled + 1 }
print(arrow(5))
let arrow_decl = (x) => { var a = x
 var b = 2 }
print(arrow_decl(1))
let arrow_stmt = (x) => { if x > 0 { print("positive") } }
print(arrow_stmt(1))
let arrow_explicit = (x) => { let d = x * 2
 return d + 1
 d + 99 }
print(arrow_explicit(5))
var bumps = 0
func bump() { bumps = bumps + 1
 return bumps }
let arrow_effect = () => bump()
print(arrow_effect())
print(arrow_effect())
print(bumps)

# `func` bodies do *not* auto-return: falling off the end yields nil.
func plain(x) { let doubled = x * 2
 doubled + 1 }
print(plain(5))

# match: no arm matching yields nil, not an error (the oracle's exec_match_arms).
var none = match "zzz" {
  "aaa": 1,
  "bbb": 2
}
print(none)
print(len(match "zzz" { "aaa": 1 }) == 0)

# match: arm bindings do not leak into the next arm or out of the match.
var leaked = "outer"
var seen = match 7 {
  leaked: {
    leaked = "inner"
  }
  _: {
    seen = leaked
  }
}
print(seen)
print(leaked)

# match: a failed arm's binding is invisible to the arms after it.
func pick(n) {
  return match n {
    k if k > 100: "big",
    k if k > 10: "medium",
    k: "small"
  }
}
print(pick(500))
print(pick(50))
print(pick(1))

# match: guards run in the arm's scope, after the pattern binds.
func guarded(n) {
  return match n {
    k if k > 0 && k < 10: "unit",
    k if k < 0: "negative",
    _: "other"
  }
}
print(guarded(5))
print(guarded(-1))
print(guarded(50))

# match: nested as an expression, arms still visible to inner matches.
var nest = match 2 {
  1: match 9 { _: "inner-one" },
  2: match 3 {
    3: "inner-two"
    _: "inner-other"
  }
}
print(nest)

# match: an empty arm list yields nil.
print(match 1 { })

# when: no condition matching yields nil too.
print(when { false: "no" })

# match inside a block-bodied arm, and a match as a call argument.
func describe(v) {
  return "v=" + match v {
    0: "zero"
    _: "other"
  }
}
print(describe(0))
print(describe(7))
print(str(match 3 { 3: [1, 2] }))
