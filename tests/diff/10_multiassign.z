num2 = 20
num1 = num2
print(num1, num2)
u = 0
v = 0
u += 1
v += 2
print(u, v)
let [a2, b2] = [5, 6]
print(a2 + b2)
let [single] = [99]
print(single)
let [x3, y3] = [10, 20, 30]
print(x3, y3)
arr = [1, 2, 3]
arr[2] = arr[0]
print(arr)
print("end")