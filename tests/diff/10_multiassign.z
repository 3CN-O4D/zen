print(a, b)
let [c, d] = [1, 2]
print(c, d)
let [m, n] = [1, 2]
let [first, second] = [m, n]
print(first, second)
let [p, q, r] = [10, 20, 30]
print(p, q, r)
x1 = 5
x2 = x1
print(x1, x2)
s1 = "multi"
s2 = s1
s3 = s2
