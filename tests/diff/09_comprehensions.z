print([x * x for x in 0..5])
print([x for x in 0..10 if x % 2 == 0])
print([x + 1 for x in [1,2,3]])
print([n for n in range(4)])
print([x ** 2 for x in range(1, 4)])
print([c for c in "abc".toList()])
print([k for k in {"a":1,"b":2}.keys()])
print([v for v in {"a":1,"b":2}.values()])
pairs = [[a, b] for a in 0..2 for b in 0..2 if a < b]
print(pairs)
squares = [i * i for i in 0..10 if i > 5]
print(squares)
print([x for x in [10, 20, 30]][1])
print([x for x in 0..100].sum())
print(len([x for x in 0..4]))
print([a for a in 1..3], [b for b in [4,5]])
grid = [[x + y for x in 0..2] for y in 0..2]
print(grid)
print(grid[1][0])
kk = [x for x in 0..3]
print(kk)
print(kk[2])
empty = [x for x in []]
print(empty.length)
nested_comp = [x for x in [1,2] for y in ["a"]]
print(nested_comp)
print([x for x in 0..3 if true])
print([x for x in 0..3 if false])
print([x for x in [1, 2, 3, 4] if x % 2 == 1].sum())
sequence = [x * 2 for x in 0..3 if x != 1]
print(sequence)
print([[0]].flat())
function comps_fn() {
  return [x * 10 for x in 0..3]
}
print(comps_fn())
print([x for x in range(3)])
print([x for x in [5, 6, 7]])
print("end")