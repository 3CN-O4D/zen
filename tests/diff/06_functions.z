function square(x) { return x * x; }
print(square(4))
function add(a, b) { return a + b; }
print(add(1, 2))
def triple(v) { return v * 3; }
print(triple(3))
def greet(name, greeting = "Hello") { return greeting + " " + name; }
print(greet("World"))
print(greet("World", "Hi"))
fact = lambda(n) { return n <= 1 ? 1 : n * fact(n - 1); }
print(fact(5))
def fib(n) { return n < 2 ? n : fib(n-1) + fib(n-2); }
print(fib(10))
f = lambda(x) { return x * 2 }
print(f(5))
print([1,2,3].map(lambda(x) { return x ** 2 }))
def apply(f, v) { return f(v); }
print(apply(lambda(x) { return x + 100 }, 1))
def outer() {
  n = 10
  return lambda() { return n; }
}
out_f = outer()
print(out_f())
def counter() {
  c = 0
  return lambda() { c += 1; return c; }
}
c1 = counter()
c2 = counter()
print(c1())
print(c1())
print(c2())
def swap(a, b) { print(a, b) }
swap(1, 2)
print([1,2,3,4].reduce(lambda(acc, x) { return acc + x }) == 10)
print([1,2,3,4].reduce(lambda(acc, x) { return acc + x }, 100))
def ret_early(x) {
  if x > 0 { return "pos" }
  return "non"
}
print(ret_early(1), ret_early(-1))
def nested_calls(n) {
  return n == 0 ? 0 : nested_calls(n - 1) + 1
}
print(nested_calls(100))
def closures_in_loop(i) {
  funcs = []
  for j in 0..i {
    funcs.push(lambda() { return j; })
  }
  return funcs
}
flist = closures_in_loop(3)
print(flist[0](), flist[1](), flist[2]())
def deep(n) { return n == 0 ? "done" : deep(n - 1) + "."; }
print(deep(5).length)
print(square(3) + square(4))
def gen(n) {
  return [lambda() { return n }, lambda() { return n * 2 }]
}
pair = gen(7)
print(pair[0](), pair[1]())
def cfg(x) { if x { return 1 } else { return 2 } }
print(cfg(true), cfg(false))
def additive(a, b) { return a + b }
print(additive(2.5, 1))
def getItem(list, i) { return list[i] }
print(getItem([10, 20, 30], 1))
def withDefault(v, d = 7) { return v == null ? d : v }
print(withDefault(null), withDefault(3))
recur = lambda(n, acc = 0) {
  if n == 0 { return acc }
  return recur(n - 1, acc + n)
}
print(recur(100))
print("end")