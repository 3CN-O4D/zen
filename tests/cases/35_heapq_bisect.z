// Test 35: heapq + bisect pure modules
let fail = 0
let check = fn(cond, label) {
    if not cond {
        fail += 1
        print "FAIL: " + label
    }
}

import heapq
import bisect

// ---- heapq ----
let h = heapq.heapify([5, 1, 4, 2, 3])
check(h[0] == 1, "heapify root")
h = heapq.heappush(h, 0)
check(h[0] == 0, "heappush new min")
let r = heapq.heappop(h)
check(r[0] == 0, "heappop value")
check(r[1][0] == 1, "heappop rest root")
let sticks = [1, 2, 3, 4, 5]
let out = []
let hh = heapq.heapify([5, 4, 3, 2, 1])
let k = 0
while k < 5 {
    let rr = heapq.heappop(hh)
    out.push(rr[0])
    hh = rr[1]
    k += 1
}
check(out == [1, 2, 3, 4, 5], "heapsort order")
check(heapq.nsmallest(3, [5, 1, 4, 2, 3]) == [1, 2, 3], "nsmallest")
check(heapq.nlargest(2, [5, 1, 4, 2, 3]) == [5, 4], "nlargest")
let hr = heapq.heapreplace([1, 5, 9], 7)
check(hr[0] == 1, "heapreplace returns old top")
check(hr[1][0] == 5, "heapreplace new root")
let hp = heapq.heappushpop([2, 8], 5)
check(hp[0] == 2, "heappushpop smaller wins")
check(heapq.heappushpop([2, 8], 1) == [1, [2, 8]], "heappushpop largercurrent")

// ---- bisect ----
let xs = [1, 3, 5, 7]
check(bisect.bisect_left(xs, 0) == 0, "bisect_left low")
check(bisect.bisect_left(xs, 5) == 2, "bisect_left hit")
check(bisect.bisect_left(xs, 6) == 3, "bisect_left mid")
check(bisect.bisect_left(xs, 9) == 4, "bisect_left high")
check(bisect.bisect_right(xs, 5) == 3, "bisect_right hit")
check(bisect.bisect_right(xs, 4) == 2, "bisect_right mid")
check(bisect.insort_left([1, 3, 5], 4) == [1, 3, 4, 5], "insort_left")
check(bisect.insort_right([1, 3, 3, 5], 3) == [1, 3, 3, 3, 5], "insort_right keeps order")
check(bisect.insort_left([], 9) == [9], "insort empty")
