// Test 36: calendar + fractions + copy pure modules
let fail = 0
let check = fn(cond, label) {
    if not cond {
        fail += 1
        print "FAIL: " + label
    }
}

import calendar
import fractions
import copy

// ---- calendar ----
check(calendar.is_leap(2000), "leap 2000")
check(not calendar.is_leap(1900), "not leap 1900")
check(calendar.is_leap(2024), "leap 2024")
check(not calendar.is_leap(2023), "not leap 2023")
check(calendar.weekday(2024, 1, 1) == 0, "2024-01-01 Monday")
check(calendar.weekday(2000, 1, 1) == 5, "2000-01-01 Saturday")
check(calendar.weekday(1970, 1, 1) == 3, "1970-01-01 Thursday")
check(calendar.weekday(2026, 10, 14) == 2, "2026-10-14 Wednesday")
check(calendar.days_in_month(2024, 2) == 29, "feb leap")
check(calendar.days_in_month(2023, 2) == 28, "feb common")
check(calendar.month_range(2024, 1) == [0, 31], "month_range")
check(calendar.MONTH_NAMES[1] == "January", "month name")
check(calendar.DAY_ABBR[0] == "Mon", "day abbr")
let cal = calendar.month_calendar(2024, 1)
check(cal[0] == [1, 2, 3, 4, 5, 6, 7], "jan24 first week")
check(calendar.month_str(2024, 1).find("January 2024") != -1, "month_str head")
check(calendar.yeardays(2024) == 366, "yeardays leap")

// ---- fractions ----
let half = fractions.Fraction(1, 2)
check(half.show() == "1/2", "fraction show")
check(fractions.Fraction(2, 4).show() == "1/2", "fraction normalize")
check(fractions.Fraction(1, -2).show() == "-1/2", "fraction neg den")
check(fractions.Fraction(4, 2).show() == "2", "fraction whole")
check(half.add(fractions.Fraction(1, 3)).show() == "5/6", "fraction add")
check(half.sub(fractions.Fraction(1, 3)).show() == "1/6", "fraction sub")
check(half.mul(fractions.Fraction(2, 3)).show() == "1/3", "fraction mul")
check(half.div(fractions.Fraction(2, 3)).show() == "3/4", "fraction div")
check(half.neg().show() == "-1/2", "fraction neg")
check(half.inv().show() == "2", "fraction inv")
check(fractions.Fraction(1, 2).eq(fractions.Fraction(2, 4)), "fraction eq")
check(not fractions.Fraction(1, 2).eq(fractions.Fraction(1, 3)), "fraction neq")
check(fractions.Fraction(1, 2).to_float() == 0.5, "fraction float")

// ---- copy ----
let orig = [1, [2, 3], {"a": 4}]
let sh = copy.shallow(orig)
check(sh == orig, "shallow equal")
let dp = copy.deepcopy(orig)
check(dp == orig, "deep equal")
check(copy.shallow(5) == 5, "shallow primitive")
check(copy.deepcopy("s") == "s", "deep primitive")
check(copy.deepcopy(null) == null, "deep null")
