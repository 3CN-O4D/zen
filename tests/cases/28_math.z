// 28_math: parity between the pure-Zen `math` tier (std/math.z) and the
// native Rust tier. The pure tier wins on import; `math["native"]` exposes
// the native members for direct comparison.
import math
import sys

let failed = 0
let check = fn(cond, what) {
    if not cond {
        print "FAIL: " + what
        failed += 1
    }
}

let n = math["native"]

let exact = fn(a, b, what) {
    check(str(a) == str(b), what)
}

let approx = fn(a, b, what) {
    let na = a != a
    let nb = b != b
    if na || nb {
        check(na == nb && str(a) == str(b), what)
        return
    }
    let sa = str(a)
    let sb = str(b)
    if sa == "inf" || sa == "-inf" || sb == "inf" || sb == "-inf" {
        check(sa == sb, what)
        return
    }
    let d = a - b
    if d < 0 { d = -d }
    check(d < 1e-12, what)
}

// --- constants -------------------------------------------------------------
check(math.pi > 3.14159 && math.pi < 3.1416, "math.pi in range")
check(math.e > 2.71828 && math.e < 2.71829, "math.e in range")
check(str(math.inf) == str(n.inf), "inf constant parity")
check(str(math.nan) == str(n.nan), "nan constant parity")

// --- arithmetic members ----------------------------------------------------
approx(math.sqrt(2), n.sqrt(2), "sqrt(2)")
exact(math.sqrt(144), n.sqrt(144), "sqrt(144)")
approx(math.sqrt(0.25), n.sqrt(0.25), "sqrt(0.25)")
for x in [3.7, -3.7, 3, -3, 0, 2.999, -2.999] {
    exact(math.floor(x), n.floor(x), "floor(" + str(x) + ")")
    exact(math.ceil(x), n.ceil(x), "ceil(" + str(x) + ")")
    exact(math.trunc(x), n.trunc(x), "trunc(" + str(x) + ")")
    exact(math.round(x), n.round(x), "round(" + str(x) + ")")
}
exact(math.round(2.5), n.round(2.5), "round(2.5)")
exact(math.round(-2.5), n.round(-2.5), "round(-2.5)")
for x in [-5, 5, -0.5, 2.5, 0] {
    exact(math.abs(x), n.abs(x), "abs(" + str(x) + ")")
}
exact(math.pow(2, 10), n.pow(2, 10), "pow(2,10)")
approx(math.pow(2, -2), n.pow(2, -2), "pow(2,-2)")
approx(math.pow(4, 0.5), n.pow(4, 0.5), "pow(4,0.5)")
approx(math.pow(2, 0.5), n.pow(2, 0.5), "pow(2,0.5)")

// --- exp/log ---------------------------------------------------------------
for x in [0, 1, -1, 2, 0.5] {
    approx(math.exp(x), n.exp(x), "exp(" + str(x) + ")")
    approx(math.log(x), n.log(x), "log(" + str(x) + ")")
    approx(math.log2(x), n.log2(x), "log2(" + str(x) + ")")
    approx(math.log10(x), n.log10(x), "log10(" + str(x) + ")")
}
approx(math.log(8, 2), n.log(8, 2), "log(8,2)")
approx(math.log(1000, 10), n.log(1000, 10), "log(1000,10)")

// --- trig ------------------------------------------------------------------
for x in [0, 1, -1, 0.5, -0.5, 1.5, -2, 2, 3.5, -3.5] {
    approx(math.sin(x), n.sin(x), "sin(" + str(x) + ")")
    approx(math.cos(x), n.cos(x), "cos(" + str(x) + ")")
    approx(math.tan(x), n.tan(x), "tan(" + str(x) + ")")
    approx(math.asin(x), n.asin(x), "asin(" + str(x) + ")")
    approx(math.acos(x), n.acos(x), "acos(" + str(x) + ")")
    approx(math.atan(x), n.atan(x), "atan(" + str(x) + ")")
    approx(math.degrees(x), n.degrees(x), "degrees(" + str(x) + ")")
    approx(math.radians(x), n.radians(x), "radians(" + str(x) + ")")
}
for x in [0.25, 0.75, -0.25, -0.75] {
    approx(math.sin(x * math.pi), n.sin(x * math.pi), "sin(pi*" + str(x) + ")")
    approx(math.cos(x * math.pi), n.cos(x * math.pi), "cos(pi*" + str(x) + ")")
}
let pairs = [[1, 1], [0, 1], [-1, 1], [1, -1], [-1, -1], [0, -1], [1, 0], [-1, 0], [0, 0], [2, 5]]
for i in list(pairs) {
    approx(math.atan2(i[0], i[1]), n.atan2(i[0], i[1]), "atan2(" + str(i[0]) + "," + str(i[1]) + ")")
}

// --- integer number theory -------------------------------------------------
let ipairs = [[12, 18], [0, 5], [-12, 18], [17, 1], [7, 13], [48, 18]]
for i in list(ipairs) {
    exact(math.gcd(i[0], i[1]), n.gcd(i[0], i[1]), "gcd(" + str(i[0]) + "," + str(i[1]) + ")")
    exact(math.lcm(i[0], i[1]), n.lcm(i[0], i[1]), "lcm(" + str(i[0]) + "," + str(i[1]) + ")")
}
for x in [0, 1, 5, 10, 15, 20] {
    exact(math.factorial(x), n.factorial(x), "factorial(" + str(x) + ")")
}
let cps = [[5, 2], [10, 3], [0, 0], [6, 6], [10, 7]]
for i in list(cps) {
    exact(math.comb(i[0], i[1]), n.comb(i[0], i[1]), "comb(" + str(i[0]) + "," + str(i[1]) + ")")
    exact(math.perm(i[0], i[1]), n.perm(i[0], i[1]), "perm(" + str(i[0]) + "," + str(i[1]) + ")")
}
exact(math.perm(5), n.perm(5), "perm(5)")

// --- float utilities -------------------------------------------------------
let f2 = [[5, 2], [5.5, 2], [4, 2], [-5, 2], [7, -3]]
for i in list(f2) {
    approx(math.remainder(i[0], i[1]), n.remainder(i[0], i[1]), "remainder(" + str(i[0]) + "," + str(i[1]) + ")")
}
check(math.copysign(3, -2) == n.copysign(3, -2), "copysign(3,-2)")
check(math.copysign(3, 2) == n.copysign(3, 2), "copysign(3,2)")
check(math.copysign(-3, 2) == n.copysign(-3, 2), "copysign(-3,2)")
for x in [3.7, -3.7, 5, 0, 0.25] {
    exact(math.modf(x), n.modf(x), "modf(" + str(x) + ")")
}
for x in [-0.5, -8, -1, 8, 1, 0.5, 1e10] {
    approx(math.frexp(x)[0], n.frexp(x)[0], "frexp(" + str(x) + ") mantissa")
    exact(math.frexp(x)[1], n.frexp(x)[1], "frexp(" + str(x) + ") exponent")
}
exact(math.frexp(0), n.frexp(0), "frexp(0)")
let le = [[1, 3], [3, -1], [0.5, 2], [2, -2]]
for i in list(le) {
    approx(math.ldexp(i[0], i[1]), n.ldexp(i[0], i[1]), "ldexp(" + str(i[0]) + "," + str(i[1]) + ")")
}

// --- aggregators -----------------------------------------------------------
approx(math.hypot(3, 4), n.hypot(3, 4), "hypot(3,4)")
approx(math.hypot(5, 12), n.hypot(5, 12), "hypot(5,12)")
approx(math.hypot([3, 4]), n.hypot(3, 4), "hypot([3,4])")
exact(math.fsum([0.1, 0.2, 0.3]), n.fsum([0.1, 0.2, 0.3]), "fsum([0.1,0.2,0.3])")
exact(math.fsum(1, 2), n.fsum(1, 2), "fsum(1,2)")
exact(math.prod([1, 2, 3]), n.prod([1, 2, 3]), "prod([1,2,3])")
exact(math.prod(2, 5), n.prod(2, 5), "prod(2,5)")
exact(math.min(3, 9), n.min(3, 9), "min(3,9)")
exact(math.max(3, 9), n.max(3, 9), "max(3,9)")
exact(math.min([3, 9, 1]), n.min([3, 9, 1]), "min([3,9,1])")
exact(math.max([3, 9, 1]), n.max([3, 9, 1]), "max([3,9,1])")

// --- predicates ------------------------------------------------------------
for x in [1, -2.5, 0] {
    check(math.isnan(x) == n.isnan(x), "isnan(" + str(x) + ")")
    check(math.isinf(x) == n.isinf(x), "isinf(" + str(x) + ")")
    check(math.isfinite(x) == n.isfinite(x), "isfinite(" + str(x) + ")")
}
check(math.isnan(math.nan) == true, "isnan(nan)")
check(math.isnan(0.0 * math.inf) == true, "isnan(0*inf)")
check(math.isinf(math.inf) == true, "isinf(inf)")
check(math.isinf(math.nan) == false, "isinf(nan)")
check(math.isfinite(math.inf) == false, "isfinite(inf)")
check(math.isfinite(math.nan) == false, "isfinite(nan)")

// --- native tier still reachable ------------------------------------------
exact(math["native"].floor(3.7), 3, "native floor via bracket")

if failed == 0 {
    print "28_math: all ok"
} else {
    print "28_math: " + failed + " failures"
    sys.exit(1)
}