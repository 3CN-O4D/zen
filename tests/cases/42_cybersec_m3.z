// Test 42: cybersec M3 — tlssweep + opsec.
// Live sweep runs against tests/mock_tls.py (127.0.0.1:2443, started by
// tests/run_tests.sh); no internet involved.
// NOTE: every std module whose functions execute must be imported by the
// entry file — nested imports do not re-export names (see troubleshooting).
let fail = 0
let check = fn(cond, label) {
    if not cond {
        fail += 1
        print "FAIL: " + label
    }
}

import opsec
import report
import tls
import tlscheck
import tlssweep
import x509

// ---- opsec: timing templates ----
check(opsec.timing_delay(0) == 3000, "T0 paranoid")
check(opsec.timing_delay(5) == 30, "T5 insane")
check(opsec.timing_delay(3) == 250, "T3 normal default")
check(opsec.timing_delay(99) == 250, "unknown template defaults")

// ---- opsec: jitter stays in band ----
let j = opsec.jitter(1000, 25)
check(j >= 750 and j <= 1250, "jitter band")
check(opsec.jitter(1000, 0) == 1000, "zero pct exact")

// ---- opsec: rotating benign headers ----
let ua = opsec.user_agent()
check(ua.startswith("Mozilla/"), "ua looks like a browser")
let h = opsec.request_headers()
check(h["User-Agent"].startswith("Mozilla/"), "headers carry UA")
check(h["Accept"].contains("text/html"), "headers carry Accept")

// ---- tlssweep: live host + dead host, never aborts ----
let res = tlssweep.sweep(["127.0.0.1:2443", "127.0.0.1:24999"], {insecure: true, timeout_ms: 3000})
check(len(res) == 2, "one result per target")
check(res[0]["ok"] == true, "mock host ok")
check(len(res[0]["findings"]) == 0, "mock cert healthy")
check(res[1]["ok"] == false, "dead port not ok")
check(res[1]["findings"][0]["severity"] == "info", "dead port is info, not error")

// ---- tlssweep: report composition ----
let r = tlssweep.sweep_report("lab sweep", ["127.0.0.1:2443", "127.0.0.1:24999"], {insecure: true, timeout_ms: 3000})
let s = r.summary()
check(s["total"] == 1 and s["info"] == 1, "report holds the info finding")
check(r.markdown().contains("# lab sweep"), "report title")

// ---- default port parsing ----
let one = tlssweep.sweep_host("127.0.0.1:2443", {insecure: true})
check(one["ok"] == true, "explicit port works")

if fail == 0 { print "SUITE PASS" } else { print "SUITE FAILURES: " + str(fail) }
