// Test 43: cybersec M4 — audit module framework (offline).
let fail = 0
let check = fn(cond, label) {
    if not cond {
        fail += 1
        print "FAIL: " + label
    }
}

import audit
import report

// ---- module lifecycle ----
let m = audit.create("lab-net", "demo module")
check(m["name"] == "lab-net", "module name kept")
check(m.set_scope(["web1", "db1"]) == 2, "scope set")
check(m.scope()[0] == "web1" and len(m.scope()) == 2, "scope read back")
check(m.in_scope("web1") == true, "in scope")
check(m.in_scope("evil") == false, "out of scope")

// ---- checks: finding, null-skip, throwing-check isolation ----
m.add_check("banner", fn(t) {
    return {severity: "low", title: "banner seen", detail: t, evidence: t, remediation: ""}
})
m.add_check("quiet", fn(t) { return null })
m.add_check("boom", fn(t) { throw "kaput" })
let fs = m.run_checks("web1")
check(len(fs) == 2, "null skipped, throw isolated")
check(fs[0]["severity"] == "low" and fs[0]["evidence"] == "web1", "finding passes through")
check(fs[1]["severity"] == "info" and fs[1]["detail"].contains("kaput"), "throw becomes info")

// ---- scope guard refuses out-of-scope targets ----
var guarded = false
try { m.run_checks("evil") } catch as e { guarded = e.contains("outside the declared scope") }
check(guarded, "out-of-scope run throws")

// ---- findings feed the report builder ----
let r = report.create("lab-net audit")
r.extend(fs)
check(r.summary()["low"] == 1 and r.summary()["info"] == 1, "report counts")
check(r.markdown().contains("banner seen"), "report renders findings")

// ---- rescope replaces, not appends ----
m.set_scope(["db1"])
check(len(m.scope()) == 1 and m.in_scope("web1") == false, "rescope replaces")

if fail == 0 { print "SUITE PASS" } else { print "SUITE FAILURES: " + str(fail) }
