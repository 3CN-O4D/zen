// Test 41: error vocabulary — modules vs dicts vs functions vs objects.
// Raw messages are asserted via `catch as e` (catching never sees the
// rustc-style rendering; that only happens at the top-level boundary).
let fail = 0
let check = fn(cond, label) {
    if not cond {
        fail += 1
        print "FAIL: " + label
    }
}

import sqlite

// ---- module call miss names the module and suggests functions ----
var m1 = ""
try { sqlite.open_memory() } catch as e { m1 = e }
check(m1.contains("module `sqlite` has no function: `open_memory`"), "module call names module")
check(m1.contains("openMemory"), "module call suggests openMemory")

// ---- module member miss (access, not call) keeps its message ----
var m2 = ""
try { sqlite.nope_attr_xyz } catch as e { m2 = e }
check(m2.contains("module `sqlite` has no member or function"), "module access names module")

// ---- ordinary dicts keep the dict vocabulary ----
let d = {a: 1}
var d1 = ""
try { d.nope_xyz() } catch as e { d1 = e }
check(d1.contains("dictionary has no method: `nope_xyz`"), "dict call keeps dict message")
check(not d1.contains("module"), "dict call never claims module")
var d2 = ""
try { d.nope_xyz } catch as e { d2 = e }
check(d2.contains("dictionary has no member: `nope_xyz`"), "dict access keeps dict message")

// ---- calling a non-function names the type ----
let f = 5
var c1 = ""
try { f() } catch as e { c1 = e }
check(c1 == "cannot call `f`: value of type `int` is not a function", "call int names type")
var c2 = ""
try { nosuchfn_xyz() } catch as e { c2 = e }
check(c2 == "undefined function: `nosuchfn_xyz`", "call undefined stays undefined")

// ---- the type vocabulary exists: functions and objects ----
func myfn() { return 1 }
check(typeof(myfn) == "function", "typeof function")
class Box {
    func init(v) {
        self.v = v
    }
}
let b = new Box(3)
check(typeof(b) == "object", "typeof object")
var o1 = ""
try { b.nope_xyz() } catch as e { o1 = e }
check(o1.contains("has no method") or o1.contains("no field"), "object miss is object-flavored")
check(not o1.contains("dictionary"), "object miss never says dictionary")

if fail == 0 { print "SUITE PASS" } else { print "SUITE FAILURES: " + str(fail) }
