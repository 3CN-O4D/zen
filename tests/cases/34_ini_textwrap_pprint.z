// Test 34: ini + textwrap + pprint pure modules
let fail = 0
let check = fn(cond, label) {
    if not cond {
        fail += 1
        print "FAIL: " + label
    }
}

import ini
import textwrap
import pprint

// ---- ini ----
let cfg = ini.parse("[server]\nhost = example.com\nport = 8080\ndebug = yes\n[db]\npath = /var/db\n")
check(cfg.get("server", "host", "?") == "example.com", "ini get")
check(cfg.getint("server", "port", 0) == 8080, "ini getint")
check(cfg.getbool("server", "debug", false) == true, "ini getbool")
check(cfg.get("server", "missing", "dflt") == "dflt", "ini default")
check(cfg.get("db", "path", "?") == "/var/db", "ini second section")
check(cfg.has_section("db"), "ini has_section")
check(cfg.has_option("server", "host"), "ini has_option")
check(not cfg.has_option("server", "nope"), "ini missing option")
cfg.set("server", "port", "9090")
check(cfg.getint("server", "port", 0) == 9090, "ini set")
let cfg2 = ini.parse("[DEFAULT]\nretries = 3\n[a]\nx = 1\n")
check(cfg2.get("a", "retries", "?") == "3", "ini default fallback")
check(cfg2.getint("a", "retries", 0) == 3, "ini default getint")
let cfg3 = ini.parse("# comment\n; another\n[m]\nurl = http://x/#y ; trailing\n")
check(cfg3.get("m", "url", "?") == "http://x/#y", "ini comment edge")
let written = cfg2.write()
check(written.find("[a]") != -1, "ini write section")
check(written.find("retries = 3") != -1, "ini write default")
check(cfg2.getfloat("a", "retries", 0.0) == 3.0, "ini getfloat")

// ---- textwrap ----
check(textwrap.wrap("aa bb cc dd", 5) == ["aa bb", "cc dd"], "wrap basic")
check(textwrap.wrap("aa bb cc dd", 4) == ["aa", "bb", "cc", "dd"], "wrap narrow")
check(textwrap.fill("aa bb cc", 4) == "aa\nbb\ncc", "fill")
check(textwrap.dedent("  a\n    b\n  c") == "a\n  b\nc", "dedent")
check(textwrap.indent("a\n\nb", "> ") == "> a\n\n> b", "indent")
let short = textwrap.shorten("aa bb cc dd ee", 8)
check(short == "aa bb...", "shorten got: " + short)
check(textwrap.shorten("aa bb", 20) == "aa bb", "shorten fits")

// ---- pprint ----
check(pprint.pformat("hi") == "'hi'", "pprint str")
check(pprint.pformat([1, 2]) == "[1, 2]", "pprint list")
check(pprint.pformat({"b": 1, "a": 2}) == "{'a': 2, 'b': 1}", "pprint dict sorted")
check(pprint.pformat(42) == "42", "pprint int")
check(pprint.pformat(null) == "null", "pprint null")
