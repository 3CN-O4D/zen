# Control flow: if/elif/else, while, for, break/continue
var fails = 0
func check(cond, name) {
    if cond { } else {
        print("FAIL: " + name)
        fails = fails + 1
    }
}

var x = 5
if x > 10 { check(false, "if taken wrongly") }
elif x == 5 { check(true, "elif branch") }
else { check(false, "else taken wrongly") }

# while with accumulator
var i = 0
var acc = 0
while i < 100 {
    acc = acc + i
    i = i + 1
}
check(acc == 4950, "while sum 0..99")

# break
var found = -1
i = 0
while i < 10 {
    if i * i > 30 {
        found = i
        break
    }
    i = i + 1
}
check(found == 6, "break on condition")

# continue
i = 0
var odd_sum = 0
while i < 10 {
    i = i + 1
    if i % 2 == 0 { continue }
    odd_sum = odd_sum + i
}
check(odd_sum == 25, "continue skips evens")

# for over list
var total = 0
for v in [1, 2, 3, 4] {
    total = total + v
}
check(total == 10, "for list sum")

# for with break
var first_big = 0
for v in [1, 50, 500] {
    if v > 100 { break }
    first_big = v
}
check(first_big == 50, "for break keeps last value")

# nested loops
var pairs = 0
for a in [1, 2, 3] {
    for b in [1, 2, 3] {
        if b > a { continue }
        pairs = pairs + 1
    }
}
check(pairs == 6, "nested loop count")

# try / catch
var caught = false
try {
    var boom = 1 / 0
} catch {
    caught = true
}
check(caught, "catch on division by zero")

try {
    var ok = 10 / 2
    check(ok == 5, "try body executes")
} catch {
    check(false, "catch fired wrongly")
}

# match: literal patterns, wildcard, both separators, dict-literal body
var status = match "ready" {
  "loading": "spinner",
  "ready" => "check",
  _: "unknown"
}
check(status == "check", "match literal arm with colon")

status = match "nope" {
  "loading": "spinner",
  "ready": "check",
  _: "unknown"
}
check(status == "unknown", "match wildcard")

# match: bare identifier binds value, guards gate fall-through
var bound = match 42 {
  n if n > 100: "big",
  n if n == 42: "forty-two",
  _: "other"
}
check(bound == "forty-two", "match guard binding")

func flag_z() { return false }
bound = match "err" {
  "err" if flag_z(): "guarded",
  "err": "plain",
  _: "other"
}
check(bound == "plain", "match guard false falls through")

# match: numeric patterns and multi-case function use
func label_of(n) {
  return match n {
    1: "one",
    2 => "two",
    _: "many"
  }
}
check(label_of(1) == "one", "match in function 1")
check(label_of(2) == "two", "match in function 2")
check(label_of(9) == "many", "match in function wildcard")

# when: condition evaluation order, wildcard
var score = 87
var grade = when {
  score >= 90: "A",
  score >= 85 => "A-",
  score >= 80: "B+",
  _: "C"
}
check(grade == "A-", "when condition arms")

grade = when {
  score > 1000: "impossible",
  _: "fallback"
}
check(grade == "fallback", "when wildcard")

# when in expression position
var sz = when {
  score >= 85: "large",
  _: "small"
}
check(sz == "large", "when as expression")

# match arms with block bodies / statements
var printed = ""
var got = match 3 {
  1: { printed = "one" },
  2: { printed = "two" },
  3: { printed = "three" }
}
check(printed == "three", "match block body executes")

# match returning dict literal body
var usr = "bob"
var info = match usr {
  "bob": { name: "Bob", id: 7 },
  _: { name: "stranger", id: 0 }
}
check(info["name"] == "Bob" && info["id"] == 7, "match dict-literal body")

if fails == 0 { print("SUITE PASS") } else { print("SUITE FAILURES: " + str(fails)) }
