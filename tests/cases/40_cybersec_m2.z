// Test 40: cybersec M2 — tls.fetch + scandiff.
// Live fetch runs against tests/mock_tls.py (127.0.0.1:2443, started by
// tests/run_tests.sh); no internet involved. scandiff is offline.
let fail = 0
let check = fn(cond, label) {
    if not cond {
        fail += 1
        print "FAIL: " + label
    }
}

import scandiff
import sqlite
import tls
import tlscheck
import x509

// ---- tls.fetch against the mock (self-signed lab cert: insecure) ----
let pem = tls.fetch("127.0.0.1", 2443, {insecure: true})
check(pem.startswith("-----BEGIN CERTIFICATE-----"), "fetch returns pem")
let c = x509.parse_pem(pem)
check(c["subject"] == "CN=audit-lab.example, O=Zen Audit, C=US", "fetched subject")
check(c["san"][0] == "audit-lab.example" and c["san"][2] == "127.0.0.1" and len(c["san"]) == 3, "fetched san")
check(len(tlscheck.from_pem(pem, "audit-lab.example")) == 0, "fetched cert healthy")

// ---- tls.fetch failure modes stay clean errors ----
var refused = false
try { tls.fetch("127.0.0.1", 24999, {timeout_ms: 2000}) } catch as e { refused = e.contains("cannot connect") }
check(refused, "refused port reports cleanly")
var unverified = false
try { tls.fetch("127.0.0.1", 2443) } catch as e { unverified = e.contains("handshake") }
check(unverified, "self-signed without insecure fails closed")

// ---- scandiff: pure diff ----
let old_scan = {host: "10.0.0.5", ports: [
    {port: 22, state: "open", service: "ssh", banner: "SSH-2.0-OpenSSH_8.9"},
    {port: 80, state: "open", service: "http", banner: "nginx/1.18.0"},
    {port: 443, state: "open", service: "https", banner: "nginx/1.18.0"},
]}
let new_scan = {host: "10.0.0.5", ports: [
    {port: 22, state: "open", service: "ssh", banner: "SSH-2.0-OpenSSH_9.6"},
    {port: 80, state: "open", service: "http", banner: "nginx/1.18.0"},
    {port: 8080, state: "open", service: "http", banner: "Apache/2.4.52"},
]}
let d = scandiff.diff(old_scan, new_scan)
check(len(d["opened"]) == 1 and d["opened"][0]["port"] == 8080, "one opened port")
check(len(d["closed"]) == 1 and d["closed"][0]["port"] == 443, "one closed port")
check(len(d["changed"]) == 1 and d["changed"][0]["port"] == 22, "one changed banner")
check(d["changed"][0]["after"]["banner"] == "SSH-2.0-OpenSSH_9.6", "changed carries after")
let same = scandiff.diff(old_scan, old_scan)
check(len(same["opened"]) == 0 and len(same["closed"]) == 0 and len(same["changed"]) == 0, "identical scans diff empty")

// ---- scandiff: sqlite roundtrip ----
let h = sqlite.openMemory()
check(scandiff.record(h, "monday", old_scan) == 3, "recorded three ports")
check(scandiff.record(h, "friday", new_scan) == 3, "recorded three ports")
let back = scandiff.restore(h, "monday")
check(back["host"] == "10.0.0.5" and len(back["ports"]) == 3, "load restores snapshot")
let dd = scandiff.compare(h, "monday", "friday")
check(len(dd["opened"]) == 1 and len(dd["closed"]) == 1 and len(dd["changed"]) == 1, "stored compare matches")
var missing = false
try { scandiff.restore(h, "someday") } catch { missing = true }
check(missing, "unknown label throws")
sqlite.close(h)

if fail == 0 { print "SUITE PASS" } else { print "SUITE FAILURES: " + str(fail) }
