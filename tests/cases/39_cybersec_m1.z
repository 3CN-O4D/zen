// Test 39: cybersec M1 — x509 + tlscheck + report (offline only).
// The PEM below is a throwaway 10-year self-signed lab cert generated once
// with openssl; the suite never touches the network.
let fail = 0
let check = fn(cond, label) {
    if not cond {
        fail += 1
        print "FAIL: " + label
    }
}

import fs
import report
import tlscheck
import x509

let PEM = '''-----BEGIN CERTIFICATE-----
MIIDkjCCAnqgAwIBAgIUFFz0Wx+l8eyhJF0ivsZh+UYR/pwwDQYJKoZIhvcNAQEL
BQAwPTEaMBgGA1UEAwwRYXVkaXQtbGFiLmV4YW1wbGUxEjAQBgNVBAoMCVplbiBB
dWRpdDELMAkGA1UEBhMCVVMwHhcNMjYxMDE2MDIzMjA0WhcNMzYxMDEzMDIzMjA0
WjA9MRowGAYDVQQDDBFhdWRpdC1sYWIuZXhhbXBsZTESMBAGA1UECgwJWmVuIEF1
ZGl0MQswCQYDVQQGEwJVUzCCASIwDQYJKoZIhvcNAQEBBQADggEPADCCAQoCggEB
AKPp1kUpv8UibVsFvcz0/8VtzeV8vZeaNPjaUyV2SSNDynjeWCb7MA1p4RB5EyJC
3BkaMOMnc9D9YwDbaKjB8fhDIMk3iXKRuji1Tx6DMZB1tGITPd9NY3Pl7zVj5h7z
6FshrzSt9h44o2Pd/f1bG3yYL3IpMH3CQ55ONq43FkOclTDxwD5A34VXUdoeEivn
4Wz/jJ44OXvimEQmLFsJXyYU5RsTF4atbgT29dih+264uqBTB9wxpY99j3NQIjuc
SV8iIjiKRR2qSkNn8qEwaiBAitWdlI6XDyJ/sIDnFvBYM+ULeg0aHRwSXRa9wgG9
NM746uWtztuza8GjDEI2pbMCAwEAAaOBiTCBhjAdBgNVHQ4EFgQUXg61/d4xticZ
5aoZFeb5h1k5tAUwHwYDVR0jBBgwFoAUXg61/d4xticZ5aoZFeb5h1k5tAUwDwYD
VR0TAQH/BAUwAwEB/zAzBgNVHREELDAqghFhdWRpdC1sYWIuZXhhbXBsZYIVd3d3
LmF1ZGl0LWxhYi5leGFtcGxlMA0GCSqGSIb3DQEBCwUAA4IBAQADefg162/LiTIc
qBoe1FJEpGD7gUdo2DR23QzlhNdghE77TK3mitT1XOv78uvjJ4VWlZ+UiITyCq4t
CcrJnkMXhpBkOzaMBkRbzLzDi+Drmm07KlI3hmk2vudmXDAB/JGF6POl8ikO1Twt
ek9Qx+XYlLNpp6XPngZ3BIwbmBTHUM97aGh0NXvNMsPDlaHaRqXwsq4U4ggNia83
EkBQkYKX0x/ho3gA0hQhKm+9lAFVARq1FOiU1kQtxiPPEbDgPrhtnRqp4kb3CZWW
c22mKyJKXqWLEWzcdaECAdDgspWdhLzDUq07miwzcgZQxaj/B2VKO66kqdufNo2L
RpcP+I7c
-----END CERTIFICATE-----
'''

// ---- x509.parse_pem ----
let c = x509.parse_pem(PEM)
check(c["subject"] == "CN=audit-lab.example, O=Zen Audit, C=US", "subject")
check(c["issuer"] == "CN=audit-lab.example, O=Zen Audit, C=US", "issuer")
check(c["version"] == 3, "version 3")
check(c["not_before"] == "2026-10-16T02:32:04Z", "not_before")
check(c["not_after"] == "2036-10-13T02:32:04Z", "not_after")
check(len(c["san"]) == 2 and c["san"][0] == "audit-lab.example" and c["san"][1] == "www.audit-lab.example", "san")
check(c["key_algo"] == "rsa" and c["key_bits"] == 2048, "rsa-2048")
check(c["sig_algo"] == "sha256WithRSAEncryption", "sig algo")
check(c["is_ca"] == true, "is_ca")
check(len(c["serial_hex"]) == 40, "serial 20 bytes hex")
let left = (c["not_after_epoch"] - time.now()) / 86400
check(left > 3000, "ten-year validity window")

var badthrew = false
try { x509.parse_pem("not a cert") } catch { badthrew = true }
check(badthrew, "malformed pem throws")

// ---- tlscheck ----
check(len(tlscheck.from_pem(PEM, "audit-lab.example")) == 0, "healthy cert, matching host")
let mismatch = tlscheck.from_pem(PEM, "other.example")
check(len(mismatch) == 1 and mismatch[0]["severity"] == "medium", "hostname mismatch is medium")

// synthetic expired / weak certs exercise the grading without fixtures
let expired = {subject: "CN=x", issuer: "CN=y", san: ["x"], is_ca: false, sig_algo: "sha256WithRSAEncryption", key_algo: "rsa", key_bits: 2048, not_before_epoch: 0, not_after_epoch: 1000, not_after: "1970-01-01T00:16:40Z"}
let fe = tlscheck.assess(expired, null)
check(len(fe) == 1 and fe[0]["severity"] == "critical", "expired is critical")
let weak = {subject: "CN=x", issuer: "CN=y", san: ["x"], is_ca: false, sig_algo: "sha1WithRSAEncryption", key_algo: "rsa", key_bits: 1024, not_before_epoch: 0, not_after_epoch: 9999999999, not_after: "2286-11-20T17:46:39Z"}
let fw = tlscheck.assess(weak, null)
check(len(fw) == 2, "weak sig plus short key")
check(fw[0]["severity"] == "high" and fw[1]["severity"] == "high", "both high")

// ---- report ----
let r = report.create("lab audit <Q3>")
r.extend(mismatch)
r.add("critical", "expired staging cert", "dead since 2023", "not_after 2023-01-01", "replace now")
let s = r.summary()
check(s["total"] == 2 and s["critical"] == 1 and s["medium"] == 1, "summary counts")
let md = r.markdown()
check(md.contains("# lab audit <Q3>") and md.contains("## [critical] expired staging cert") and md.contains("Findings: 2 (critical 1"), "markdown shape")
let html = r.html()
check(html.contains("&lt;Q3&gt;") and html.contains("<table") and not html.contains("<Q3>"), "html escaped")
let path = r.save("/tmp/zen_test/report_m1.md")
check(path == "/tmp/zen_test/report_m1.md" and fs.read(path).contains("expired staging cert"), "save roundtrip")
var sevthrew = false
try { r.add("bogus", "t", "d") } catch { sevthrew = true }
check(sevthrew, "unknown severity throws")

if fail == 0 { print "SUITE PASS" } else { print "SUITE FAILURES: " + str(fail) }
