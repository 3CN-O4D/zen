// Test 38: cybersec M0 — hashid + codec + fingerprint (offline only).
let fail = 0
let check = fn(cond, label) {
    if not cond {
        fail += 1
        print "FAIL: " + label
    }
}

import base64
import binascii
import codec
import fingerprint
import hashlib
import hashid

// ---- hashid: real hex digests ----
let md5hex = hashlib.md5("abc").hexdigest()
check(hashid.likely(md5hex) == "md5", "md5 hex identified")
let sha1hex = hashlib.sha1("abc").hexdigest()
check(hashid.likely(sha1hex) == "sha1", "sha1 hex identified")
let sha256hex = hashlib.sha256("abc").hexdigest()
check(hashid.likely(sha256hex) == "sha256", "sha256 hex identified")
// ambiguous lengths stay honest: every candidate is returned
check(len(hashid.identify(md5hex)) == 3, "32-hex returns md5/ntlm/md4")
check(len(hashid.identify(sha256hex)) == 3, "64-hex returns sha256/sha3-256/blake2s")
let sha512hex = hashlib.sha512("abc").hexdigest()
check(hashid.identify(sha512hex)[0]["confidence"] == "high", "128-hex leads with sha512")

// ---- hashid: modular crypt formats ----
var body = ""
var i = 0
while i < 53 { body += "A"; i += 1 }
check(hashid.likely("$2b$12$" + body) == "bcrypt", "bcrypt identified")
check(hashid.likely("$1$saltsalt$hashhashhashhashhash") == "md5crypt", "md5crypt identified")
check(hashid.likely("$5$saltsalt$hashhashhashhashhash") == "sha256crypt", "sha256crypt identified")
check(hashid.likely("$6$saltsalt$hashhashhashhashhash") == "sha512crypt", "sha512crypt identified")
check(hashid.likely("$apr1$saltsalt$hashhashhashhash") == "apr1", "apr1 identified")
check(hashid.likely("$argon2id$v=19$m=65536,t=3,p=4$c2FsdA$aGFzaA") == "argon2", "argon2 identified")

// ---- hashid: non-hashes ----
check(len(hashid.identify("xyz!!!")) == 0, "garbage identifies nothing")
check(hashid.likely("xyz!!!") == null, "likely garbage is null")
check(hashid.likely("abc123") == null, "short hex is null")

// ---- codec: rot13 / rot47 ----
check(codec.rot13("hello") == "uryyb", "rot13 hello")
check(codec.rot13("uryyb") == "hello", "rot13 roundtrip")
check(codec.rot47("hello") == "96==@", "rot47 hello")
check(codec.rot47(codec.rot47("hello, World!")) == "hello, World!", "rot47 roundtrip")

// ---- codec: xor ----
check(codec.xor("AAA", 1) == "@@@", "xor single byte")
check(codec.xor(codec.xor("secret!", "key"), "key") == "secret!", "xor string-key roundtrip")
var xthrew = false
try { codec.xor("a", "") } catch { xthrew = true }
check(xthrew, "xor empty key throws")

// ---- codec: jwt_decode ----
let hpart = base64.url_encode("{\"alg\":\"HS256\",\"typ\":\"JWT\"}")
let ppart = base64.url_encode("{\"sub\":\"123\",\"name\":\"Ada\"}")
let tok = codec.jwt_decode(hpart + "." + ppart + ".sig")
check(tok["header"]["alg"] == "HS256", "jwt header alg")
check(tok["payload"]["name"] == "Ada", "jwt payload name")
check(tok["signature"] == "sig", "jwt signature kept")
var jthrew = false
try { codec.jwt_decode("only.two") } catch { jthrew = true }
check(jthrew, "jwt two segments throws")

// ---- codec: pipe ----
check(codec.pipe("hi", ["b64e", "rot13"]) == codec.rot13(base64.encode("hi")), "pipe b64e+rot13")
check(codec.pipe(codec.pipe("hi", ["hex"]), ["unhex"]) == "hi", "pipe hex roundtrip")
var pthrew = false
try { codec.pipe("hi", ["nope"]) } catch { pthrew = true }
check(pthrew, "pipe unknown step throws")

// ---- fingerprint ----
let ssh = fingerprint.service("SSH-2.0-OpenSSH_9.6p1 Ubuntu-1")
check(ssh["product"] == "openssh" and ssh["version"] == "9.6p1" and ssh["confidence"] == "high", "ssh openssh")
let ftp = fingerprint.service("220 ftp.example.com vsFTPd 3.0.3")
check(ftp["product"] == "vsftpd" and ftp["version"] == "3.0.3", "ftp vsftpd")
let pro = fingerprint.service("220 ProFTPD 1.3.8 Server ready")
check(pro["product"] == "proftpd" and pro["version"] == "1.3.8", "ftp proftpd")
let ngx = fingerprint.service("nginx/1.18.0")
check(ngx["product"] == "nginx" and ngx["version"] == "1.18.0" and ngx["confidence"] == "high", "http nginx")
let apa = fingerprint.service("Apache/2.4.52 (Ubuntu)")
check(apa["product"] == "apache" and apa["version"] == "2.4.52", "http apache")
let iis = fingerprint.http_server("Microsoft-IIS/10.0")
check(iis["product"] == "iis" and iis["version"] == "10.0", "http iis alias")
let mail = fingerprint.service("220 mail.example.com ESMTP Postfix")
check(mail["product"] == "postfix", "smtp postfix")
let unk = fingerprint.service("hello world")
check(unk["product"] == "unknown" and unk["confidence"] == "none", "unknown stays unknown")

if fail == 0 { print "SUITE PASS" } else { print "SUITE FAILURES: " + str(fail) }
