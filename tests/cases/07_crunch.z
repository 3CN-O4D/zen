# crunch module (Rust-native generators)
var fails = 0
func check(cond, name) {
    if cond { } else {
        print("FAIL: " + name)
        fails = fails + 1
    }
}

import crunch

# charset sizes
check(crunch.charset("lower").length() == 26, "charset lower")
check(crunch.charset("upper").length() == 26, "charset upper")
check(crunch.charset("digits").length() == 10, "charset digits")

# generate: exhaustive 2-char lowercase = 676 combos, first/last known
var gen = crunch.generate(2, 2, "lower")
check(gen.length() == 676, "generate size 26*26")
check(gen[0] == "aa", "generate first")
check(gen[675] == "zz", "generate last")

# single-char digits
var digs = crunch.generate(1, 1, "d")
check(digs.length() == 10 && digs[9] == "9", "generate digits")

# pattern slots via :token syntax (:d = digit slot), literals pass through
var pats = crunch.pattern(":d")
check(pats.length() == 10 && pats[0] == "0" && pats[9] == "9", "pattern single digit")
var pats2 = crunch.pattern(":d:d")
check(pats2.length() == 100 && pats2[0] == "00" && pats2[99] == "99", "pattern two digits expands fully")
var pats3 = crunch.pattern("fix:d")
check(pats3.length() == 10 && pats3.contains("fix7"), "pattern with literal prefix")

if fails == 0 { print("SUITE PASS") } else { print("SUITE FAILURES: " + str(fails)) }
